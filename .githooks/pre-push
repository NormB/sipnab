#!/bin/sh
# sipnab pre-push hook (portable POSIX sh).
#
# Hard gate: refuse to push code that fails any of
#   * `cargo fmt --all -- --check`,
#   * `cargo clippy --all-features --all-targets -- -D warnings`,
#   * `cargo doc --no-deps --all-features --workspace` (RUSTDOCFLAGS -D warnings),
#   * `cd fuzz && cargo check`,
#   * `vale docs/ website/content/ README.md SUPPORT.md MAINTAINERS.md`, or
#   * `codespell` over the same paths CI passes it.
# These are the exact gaps that break CI -- unformatted, lint-dirty, doc-broken,
# fuzz-broken, or misspelt work must never reach the remote, since CI runs all
# six as blocking gates. The two prose gates arrived last and for cause: on
# 2026-08-03 Vale turned main red with 12 passive-voice errors, and codespell
# followed with two "pre-empt ==> preempt" hits, each found only after a push. The doc and fuzz gates matter because neither is built by
# `cargo test` or `clippy --all-targets`: rustdoc lints (e.g. private intra-doc
# links) and the separate fuzz workspace compile independently. Catching them
# locally turns a 10-minute red-CI round-trip into seconds before push.
#
# Plus ONE conditional gate, at the end: validation against the real capture
# corpus named by SIPNAB_CORPUS. It runs only when that variable resolves to a
# readable directory, and says so in one line when it does not. Unlike the five
# above, CI can never take this one over -- the captures carry PII and do not
# leave the machine that recorded them.
#
# Bypass for emergencies (use sparingly):
#   SKIP_FMT_HOOK=1    git push ...   # skips ALL gates, corpus included
#   SKIP_CORPUS_HOOK=1 git push ...   # skips ONLY the corpus gate
#
# Activate once per clone:
#   git config core.hooksPath .githooks

set -eu

# Colors only when stdout is a TTY (keeps CI logs / pipes clean).
if [ -t 1 ]; then
	RED='\033[0;31m'
	GREEN='\033[0;32m'
	YELLOW='\033[1;33m'
	NC='\033[0m'
else
	RED=''
	GREEN=''
	YELLOW=''
	NC=''
fi

printf '%bRunning pre-push checks...%b\n' "$YELLOW" "$NC"

# Emergency bypass.
if [ "${SKIP_FMT_HOOK:-0}" = "1" ]; then
	printf '%bSKIP_FMT_HOOK=1 set -- skipping format/lint gate.%b\n' "$YELLOW" "$NC"
	exit 0
fi

# cargo must be available; if it is not, fail closed (better to block than to
# let unformatted code slip past unchecked).
if ! command -v cargo >/dev/null 2>&1; then
	printf '%bcargo not found on PATH -- cannot verify formatting.%b\n' "$RED" "$NC"
	printf 'Install Rust (https://rustup.rs) or bypass with SKIP_FMT_HOOK=1.\n'
	exit 1
fi

# -- Hard gate: rustfmt -------------------------------------------------------
printf '  cargo fmt --all -- --check ... '
if cargo fmt --all -- --check; then
	printf '%bOK%b\n' "$GREEN" "$NC"
else
	printf '%bFAIL%b\n' "$RED" "$NC"
	printf '\n'
	printf '%bPush blocked: code is not formatted.%b\n' "$RED" "$NC"
	printf 'Fix it with:\n'
	printf '    cargo fmt --all\n'
	printf 'then stage, commit, and push again.\n'
	printf '\n'
	printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
	exit 1
fi

# -- Hard gate: clippy --------------------------------------------------------
# Mirrors CI exactly (`cargo clippy --all-features --all-targets -- -D warnings`)
# so a lint that would fail CI fails here first. `--all-features --all-targets`
# is broader than pre-commit's `--features full`: it also lints tests, benches,
# and examples, and every feature-gated path.
printf '  cargo clippy --all-features --all-targets -- -D warnings ... '
if cargo clippy --all-features --all-targets -- -D warnings; then
	printf '%bOK%b\n' "$GREEN" "$NC"
else
	printf '%bFAIL%b\n' "$RED" "$NC"
	printf '\n'
	printf '%bPush blocked: clippy reported warnings.%b\n' "$RED" "$NC"
	printf 'Fix them with:\n'
	printf '    cargo clippy --all-features --all-targets --fix\n'
	printf 'or address them by hand, then commit and push again.\n'
	printf '\n'
	printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
	exit 1
fi

# -- Hard gate: rustdoc -------------------------------------------------------
# Mirrors CI's Docs step (`cargo doc --no-deps --all-features --workspace` with
# RUSTDOCFLAGS=-D warnings). Catches broken or private intra-doc links that
# clippy and the test suite never build.
printf '  cargo doc --no-deps --all-features --workspace (RUSTDOCFLAGS=-D warnings) ... '
if RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features --workspace; then
	printf '%bOK%b\n' "$GREEN" "$NC"
else
	printf '%bFAIL%b\n' "$RED" "$NC"
	printf '\n'
	printf '%bPush blocked: rustdoc reported warnings (e.g. a broken or private intra-doc link).%b\n' "$RED" "$NC"
	printf 'Reproduce with:\n'
	printf '    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features --workspace\n'
	printf 'fix the docs, then commit and push again.\n'
	printf '\n'
	printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
	exit 1
fi

# -- Hard gate: fuzz targets --------------------------------------------------
# Mirrors CI's fuzz-check (`cd fuzz && cargo check`). The fuzz crate is a
# separate workspace that `cargo test` / `clippy --all-targets` never build, so
# a struct or signature change can compile everywhere else yet break a fuzz
# target. Skipped if the fuzz/ directory is absent (matches CI).
if [ -d fuzz ]; then
	printf '  (cd fuzz && cargo check) ... '
	if ( cd fuzz && cargo check ); then
		printf '%bOK%b\n' "$GREEN" "$NC"
	else
		printf '%bFAIL%b\n' "$RED" "$NC"
		printf '\n'
		printf '%bPush blocked: fuzz targets do not compile.%b\n' "$RED" "$NC"
		printf 'Reproduce with:\n'
		printf '    cd fuzz && cargo check\n'
		printf 'fix the fuzz targets, then commit and push again.\n'
		printf '\n'
		printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
		exit 1
	fi
fi

# -- Hard gate: reduced feature combinations ----------------------------------
# Everything above this point builds with --all-features, and that is exactly
# the blind spot: `#[cfg]`-gating rot is invisible to it. ci.yml's features job
# records the earlier instance -- "at one point 7 of 8 reduced combos failed to
# build" -- and it happened again on the 0.5.61 release commit, where a new test
# reflected over `Cli` (behind the `native` feature) and took the whole
# site_journey_test target out of every build without it. Cost: a red main, a
# fix commit and a delayed release, for something a three-second check catches.
#
# A representative subset, not all eleven: `tls` and `api` are the combos that
# EXCLUDE native, which is where the gating breaks, and `wasm` is the most
# distant target. The full matrix stays in CI -- this is the cheap filter that
# stops the obvious break reaching it.
for combo in tls api; do
	# Skip a combination this crate does not define, the way the fuzz gate
	# skips a missing fuzz/. Without this the gate fails closed on any crate
	# without these exact feature names -- which is every throwaway fixture in
	# scripts/test-pre-push.sh, and it blocked all of them on the first run.
	if ! grep -qE "^[[:space:]]*${combo}[[:space:]]*=" Cargo.toml; then
		continue
	fi
	printf '  cargo check --no-default-features --features %s --tests ... ' "$combo"
	if cargo check --no-default-features --features "$combo" --tests; then
		printf '%bOK%b\n' "$GREEN" "$NC"
	else
		printf '%bFAIL%b\n' "$RED" "$NC"
		printf '\n'
		printf '%bPush blocked: the %s feature combination does not build.%b\n' "$RED" "$combo" "$NC"
		printf 'Reproduce with:\n'
		printf '    cargo check --no-default-features --features %s --tests\n' "$combo"
		printf 'Usually a test or item that needs a feature-gated module without\n'
		printf 'saying so -- gate the item, not the whole file, so the checks that\n'
		printf 'do not need the feature keep running everywhere.\n'
		printf '\n'
		printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
		exit 1
	fi
done

if grep -qE '^[[:space:]]*wasm[[:space:]]*=' Cargo.toml; then
printf '  cargo check --no-default-features --features wasm --lib ... '
if cargo check --no-default-features --features wasm --lib; then
	printf '%bOK%b\n' "$GREEN" "$NC"
else
	printf '%bFAIL%b\n' "$RED" "$NC"
	printf '\n'
	printf '%bPush blocked: the wasm build is broken.%b\n' "$RED" "$NC"
	printf 'Reproduce with:\n'
	printf '    cargo check --no-default-features --features wasm --lib\n'
	printf '\n'
	printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
	exit 1
fi
fi

# -- Hard gate: the non-Linux arm of every platform cfg -----------------------
# Sibling of the feature-combination gates above, for the same reason and one
# axis over: those cover `#[cfg(feature = ...)]` rot, and this covers
# `#[cfg(target_os = ...)]` rot. Both are invisible to a check that only ever
# compiles one arm.
#
# The gap it closes is total. CI is the ONLY non-Linux build in this project, so
# until now nothing local could see a macOS break -- and two reached CI on
# 2026-08-07, hours apart, out of the same module:
#
#   34defd5  error[E0425]: cannot find value `FANOUT_HASH_WITH_ROLLOVER`
#   82eb8ff  error: unused variable: `fanout_group`   (under -D warnings)
#
# Every gate above this one passed on both. Verified rather than assumed: with
# 82eb8ff reverted, `cargo clippy --all-features --all-targets -- -D warnings`
# exits 0 here, and so does the wasm check -- `capture::fanout` is
# `#[cfg(feature = "native")]` and `wasm` excludes `native`, so an unconditional
# `compile_error!` in that file does not even fail the wasm gate. With both
# breaks reintroduced one at a time, this gate blocks and names each.
#
# scripts/check-non-linux.sh explains HOW (it re-checks a copy of the tree with
# the `target_os` values swapped, on a Linux host) and, at length, which four
# alternatives were tried and what killed each -- the FreeBSD cross-check dying
# in libmimalloc-sys is the one already on the record, in 82eb8ff's own message.
#
# Resolved from the HOOK's location, not the working directory, so that
# scripts/test-pre-push.sh -- which runs this hook from inside a throwaway
# fixture crate -- exercises the real script instead of skipping a gate that
# happens not to exist over there. A gate the BDD suite cannot reach is a gate
# nobody has tested; the reduced-combo comment above records that exact lesson.
NONLINUX_GATE="$(dirname "$0")/../scripts/check-non-linux.sh"
if [ ! -f "$NONLINUX_GATE" ]; then
	printf '%b  non-Linux cfg: NOT CHECKED -- scripts/check-non-linux.sh is missing%b\n' \
		"$YELLOW" "$NC"
else
	printf '  non-Linux cfg (the macOS arm of every target_os split) ... '
	set +e
	NONLINUX_OUTPUT=$(sh "$NONLINUX_GATE" 2>&1)
	NONLINUX_RC=$?
	set -e
	case "$NONLINUX_RC" in
	0)
		printf '%bOK%b\n' "$GREEN" "$NC"
		;;
	2)
		# The script could not run -- wrong host, no clippy, no platform cfgs
		# to invert. It says which on its first line. NOT CHECKED and never
		# silence, the same rule the corpus and prose gates follow: an absent
		# verdict that reads as a pass is worse than no gate at all.
		printf '%b%s%b\n' "$YELLOW" "$(printf '%s\n' "$NONLINUX_OUTPUT" | head -1)" "$NC"
		;;
	*)
		printf '%bFAIL%b\n' "$RED" "$NC"
		NONLINUX_LOG="$(git rev-parse --git-dir 2>/dev/null || echo .)/sipnab-pre-push-nonlinux.log"
		printf '%s\n' "$NONLINUX_OUTPUT" >"$NONLINUX_LOG"
		# Name what broke, here, now. Sending someone away to re-run a
		# 50-second check just to learn the error is the cost pre-commit
		# already charged once and had to stop charging. `error:` lines carry
		# the message and `--> ` the file and line, which together are the
		# whole diagnosis for this class.
		printf '%s\n' "$NONLINUX_OUTPUT" \
			| grep -E '^(error|warning)(\[[^]]*\])?:|^ +--> ' \
			| head -20 | sed 's/^/    /'
		printf '  Full output: %s\n' "$NONLINUX_LOG"
		printf '\n'
		printf '%bPush blocked: the code does not build for a non-Linux target.%b\n' "$RED" "$NC"
		printf 'Reproduce with:\n'
		printf '    sh scripts/check-non-linux.sh\n'
		printf 'Line numbers are the real ones -- the check compiles a copy of this\n'
		printf 'tree under target/nonlinux-shim/tree with the target_os values\n'
		printf 'swapped, so a fix belongs in the file the error names.\n'
		printf '\n'
		printf 'Usually one platform decision written twice: a cfg on a use but not\n'
		printf 'on the binding, or Linux-only tests for a cross-platform module.\n'
		printf 'Prefer making the mistake unrepresentable -- one platform split, in\n'
		printf 'one place -- over adding a second cfg to paper over the first.\n'
		printf '\n'
		printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
		exit 1
		;;
	esac
fi

# -- Hard gate: a v* tag must point at a commit whose CI is green -------------
# `docs/internals/build-ci-release.md` used to open with "a release is a pushed
# v* tag" and say nothing about checking first -- so the entire safeguard was
# whoever happened to be tagging remembering to look. It mattered once already:
# the 0.5.61 release commit went red in Features (tls), and only a manual check
# stopped a broken build being published with SBOMs, provenance and a Homebrew
# tap push attached to it.
#
# stdin is the only place a pre-push hook learns what is being pushed. git
# always provides it; the loop simply finds nothing when a caller does not.
tag_commits=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/tags/v*) ;;
	*) continue ;;
	esac
	# All-zero local sha means the tag is being DELETED -- nothing to verify.
	case "$local_sha" in
	0000000000000000000000000000000000000000) continue ;;
	esac
	# An annotated tag's sha is the tag object; resolve to the commit it marks.
	commit=$(git rev-list -n 1 "$local_sha" 2>/dev/null || echo "")
	if [ -n "$commit" ]; then
		tag_commits="$tag_commits $commit"
	fi
done

for commit in $tag_commits; do
	short=$(printf '%s' "$commit" | cut -c1-7)
	# Skip rather than block when gh is unusable. Blocking would force
	# SKIP_FMT_HOOK=1, which switches off fmt, clippy, rustdoc, fuzz and the
	# feature combinations too -- turning one missing optional tool into "run
	# no checks at all". The gate works where it can and says so where it
	# cannot.
	if ! command -v gh >/dev/null 2>&1; then
		printf '%b  tag %s: gh not installed -- CI status NOT verified%b\n' \
			"$YELLOW" "$short" "$NC"
		continue
	fi
	printf '  tag -> %s: checking CI ... ' "$short"
	# Scoped by commit, NOT by recency. `--limit 30` was a window over the most
	# recent runs, so an older commit fell out of it and the gate reported "no
	# CI runs found" for one that had plenty -- the right verdict reached
	# through a claim it had not checked, which is the defect this repository
	# keeps finding. Note the FULL sha: `--commit` silently returns nothing for
	# an abbreviated one.
	runs=$(gh run list --commit "$commit" --limit 50 \
		--json headSha,status,conclusion,name 2>/dev/null || echo "")
	if [ -z "$runs" ]; then
		printf '%bSKIPPED (gh unavailable or unauthenticated)%b\n' "$YELLOW" "$NC"
		continue
	fi
	# The headSha filter is redundant with --commit and kept deliberately: if a
	# future gh ignores the flag, this still refuses to judge one commit by
	# another commit's runs.
	mine=$(printf '%s' "$runs" | jq -r --arg c "$commit" \
		'[.[] | select(.headSha == $c)] | .[] | "\(.status)/\(.conclusion // "-")/\(.name)"' 2>/dev/null || echo "")
	if [ -z "$mine" ]; then
		printf '%bFAIL%b\n' "$RED" "$NC"
		printf '\n'
		printf '%bPush blocked: no CI runs found for %s.%b\n' "$RED" "$short" "$NC"
		printf 'Push the commit and let CI run before tagging it. A tag starts a\n'
		printf 'release that publishes artifacts, SBOMs, provenance and a Homebrew\n'
		printf 'formula -- from whatever that commit contains.\n'
		printf '\n'
		printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
		exit 1
	fi
	unfinished=$(printf '%s\n' "$mine" | grep -cv '^completed/' || true)
	failed=$(printf '%s\n' "$mine" | grep -c '^completed/[^s]' || true)
	if [ "$unfinished" -ne 0 ] || [ "$failed" -ne 0 ]; then
		printf '%bFAIL%b\n' "$RED" "$NC"
		printf '\n'
		printf '%bPush blocked: CI on %s is not green.%b\n' "$RED" "$short" "$NC"
		printf '%s\n' "$mine" | sed 's/^/    /'
		printf '\n'
		printf 'Wait for it to finish, or fix it, then tag the commit that passed.\n'
		printf 'Tagging a red commit publishes a broken release -- it happened on\n'
		printf 'the 0.5.61 release commit, which failed Features (tls).\n'
		printf '\n'
		printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
		exit 1
	fi
	printf '%bOK%b\n' "$GREEN" "$NC"
done

# -- Conditional gate: the real capture corpus --------------------------------
# The standing rule in this project is 100% validation against the real capture
# corpus, and anything short of 100% counts as a critical failure. Nothing
# enforced that between one manual run and the next: on 2026-08-03 a corpus test
# turned out to have been failing on every real capture for WEEKS, unnoticed,
# because no automation ever ran it.
#
# CI cannot be that automation. The corpus is traffic recorded off live networks
# and carries PII in every packet, so nobody commits it, uploads it or caches
# it -- it does not leave the machine that captured it. A hosted runner has
# nothing to validate against. The moment before a push is the only enforcement
# point that exists.
#
# CONDITIONAL, not mandatory. A contributor without the corpus must still be
# able to push, so an absent or unreadable SIPNAB_CORPUS prints one line and
# falls through. Printing that line is the whole point: silence in a column of
# OK lines reads as "corpus validated", and a skipped check nobody knows about
# is precisely the hole this gate closes. VALIDATED and NOT VALIDATED are
# different words on purpose, and neither one of them is silence.
#
# LAST in the hook, after five cheap gates that fail in seconds. Waiting a
# minute on the corpus only to be told the tree does not compile wastes the
# minute; this way every fast verdict lands first.
#
# ---- Every corpus binary, and no subset. What the 8-minute figure measured ----
# Measured here (14 cores, corpus 8.8 GB across 137 files, warm page cache),
# binaries already built:
#
#   all eleven, ONE `cargo test` invocation, --profile profiling ......  87 s
#   the same eleven, one invocation EACH, --profile profiling ......... 379 s
#   the nine `*corpus*` binaries, one invocation, DEV profile ......... 460 s
#
# Two separate findings, and together they remove the reason to subset.
#
# One invocation, not a loop: the in-process `finished in` times sum to 86 s
# either way, so the extra 293 s is pure cargo -- a dependency-graph re-resolve
# per start, plus contention on the shared package-cache lock when any other
# cargo is running. The loop reads better and costs five times the wall clock.
#
# --profile profiling, not dev: 70 s against 460 s for the same nine binaries.
# The corpus is 8.8 GB of packets and the parsers are the whole workload, so an
# unoptimized build is where the eight-minute figure came from. Not --release
# either: [profile.release] sets panic = "abort", and an aborting test process
# dies before libtest prints its `failures:` list or its `test result:` line --
# the gate would block the push and be unable to name what broke, which is the
# one thing it has to do. `profiling` inherits release (lto, codegen-units = 1)
# and restores panic = "unwind".
#
# So the whole corpus costs about ninety seconds, and at ninety seconds a subset
# buys nothing worth its cost. The eleven do not overlap: diagnosis claims and
# message retention, ICMP evidence for signalling and for media separately,
# conformance-rule hit rates, `nat_mismatch`/`no_media` firing where they should,
# detector clocks against the capture's own timeline, every documented filter
# field and alias, behavioural scanner alerts backed by an outcome, the two
# silent-loss fixes, `-I` input-set accounting, and RTP-quality provenance.
# Dropping any one leaves that class of real-capture regression with nothing
# watching it -- which is exactly how the failure above survived for weeks.
#
# Eleven and not the nine whose names contain "corpus": input_set_accounting_test
# and rtp_quality_provenance_test read SIPNAB_CORPUS too, and cost 17 s of the
# 87. "100% of the corpus tests" has to mean all of the ones that read it, which
# is also why the list below comes from the tree instead of from this comment --
# eleven is what it measured, not what it is fixed at.
#
# The BUILD is the real cost, not the run, and it is the one number worth
# knowing before this gate surprises anyone:
#
#   corpus run, everything already built ............................  87 s
#   profiling rebuild after a lib change, then the run .............. 413 s
#
# lto = true and codegen-units = 1 mean every one of those binaries relinks
# with full LTO. Two things make it the right trade anyway. target/profiling
# persists, so a second push that touches no source pays 87 s, not 413. And the
# alternative is worse in the common case, not better: the dev profile costs
# 460 s of RUN on EVERY push and never amortizes anything.
#
# To take the wait off the push itself, keep the profile warm while working:
#   cargo test --all-features --profile profiling --no-run
#
# Emergency bypass, deliberately its OWN variable. SKIP_FMT_HOOK=1 switches off
# every gate in this hook, which is far too much to reach for when the only
# problem is a corpus that is temporarily unavailable. SKIP_CORPUS_HOOK=1 drops
# this gate and leaves the other five standing, and prints a line loud enough
# that the push it let through stays on the record. Awkward on purpose: it is
# not the variable anyone already has in their shell history.

# DERIVED from the tree, never hand-listed. Every top-level tests/*.rs is a
# cargo test target, so "the corpus suite" is exactly those that name the
# variable. The hand-kept alternative is the defect `.githooks/pre-commit`
# already records against its WASM export list: a fixed list cannot catch a NEW
# member, which is the one thing the guard is for. The first draft DID hand-list
# them, and it went stale within the hour -- a twelfth corpus binary landed in
# tests/ while this gate was still being reviewed, and the hand-kept version
# would have run eleven of twelve and printed VALIDATED.
# >>> BEGIN corpus-gate
# Everything between this marker and END corpus-gate is extracted VERBATIM and
# executed by tests/corpus_push_gate_test.rs, which drives it with a stub
# `cargo` to prove it blocks on a failing corpus and passes on a clean one.
# Nothing else in this hook is covered that way, so the markers are not
# decoration: move or delete them and that test fails rather than going quiet.
# The block may rely on GREEN/RED/YELLOW/NC, `git`, `cargo` and a cwd at the
# repo root, and on nothing else this hook defines above it.
CORPUS_TESTS=$(grep -lE '\bSIPNAB_CORPUS\b' tests/*.rs 2>/dev/null \
	| sed -e 's|^tests/||' -e 's|\.rs$||' | sort || true)

# ---- Naming what failed -----------------------------------------------------
# This gate has to capture cargo's output rather than let it stream: it drives
# every corpus binary in one run, and the per-gate summary this hook is built
# around would drown. Capturing is not licence to discard. pre-commit learned
# that the expensive way -- printing `FAIL` and a "run it yourself" line made
# whoever hit it pay for a SECOND full suite run just to learn the name of the
# test, and until that run finished they could not tell whether the break was
# theirs or already on HEAD. Here that second run is ninety seconds of parsing
# 8.8 GB. So every failure path below prints the part of the capture that names
# the problem, writes the whole capture beside it, and stays bounded.
CORPUS_LOG_DIR=$(git rev-parse --git-dir 2>/dev/null || echo .)

# Print at most <max> lines of stdin, indented, then say how many were withheld
# and where the rest lives. awk rather than a shell loop: POSIX sh has no
# `local`, and this hook runs under `set -eu` where a stray global bites.
#
# `logpath`, NOT `log`. mawk -- /usr/bin/awk on Debian and Ubuntu -- refuses
# `-v log=...` with "cannot command line assign to log: type clash or keyword",
# because log() is a built-in. It refuses at RUN time, so the gate still ran, the
# suite still failed, the push was still blocked, and every line naming the
# failing test was replaced by an awk error. A gate that blocks without saying
# what broke is the exact defect this section exists to prevent, and it took
# running the hook to find: shellcheck, `dash -n` and gawk are all happy with it.
emit_capped() { # emit_capped <max-lines> <log-path>   (reads stdin)
	awk -v max="$1" -v logpath="$2" '
		NR <= max { printf "    %s\n", $0; next }
		{ extra++ }
		END {
			if (extra > 0) {
				printf "    ... %d more line(s) in %s\n", extra, logpath
			}
		}'
}

# Which of the five states this run is in. Resolved before anything prints, so
# the gate says one thing and then does exactly that thing.
corpus_state=run
if [ "${SKIP_CORPUS_HOOK:-0}" = "1" ]; then
	corpus_state=bypassed
elif [ -z "$CORPUS_TESTS" ]; then
	# Skip rather than fail closed on a crate with no corpus targets -- the
	# same courtesy the fuzz gate extends to a missing fuzz/ and the feature
	# gate to an undefined combination. Without it every throwaway fixture
	# crate in scripts/test-pre-push.sh would be blocked.
	corpus_state=absent
elif [ -z "${SIPNAB_CORPUS:-}" ]; then
	corpus_state=notset
elif [ ! -d "$SIPNAB_CORPUS" ] || [ ! -r "$SIPNAB_CORPUS" ] || [ ! -x "$SIPNAB_CORPUS" ]; then
	# -d, -r AND -x: a directory you cannot read gives an empty walk, and an
	# empty walk is a corpus test passing over nothing. "Set but wrong" has to
	# report as loudly as "not set", never as a pass.
	corpus_state=unreadable
fi

case "$corpus_state" in
bypassed)
	printf '%b  corpus: BYPASSED (SKIP_CORPUS_HOOK=1) -- real captures NOT validated%b\n' \
		"$YELLOW" "$NC"
	;;
absent)
	printf '%b  corpus: NOT VALIDATED -- no corpus test targets in this crate%b\n' \
		"$YELLOW" "$NC"
	;;
notset)
	printf '%b  corpus: NOT VALIDATED -- SIPNAB_CORPUS is unset%b\n' "$YELLOW" "$NC"
	printf '    Point it at a capture directory to validate: SIPNAB_CORPUS=/path/to/pcaps git push\n'
	;;
unreadable)
	printf '%b  corpus: NOT VALIDATED -- SIPNAB_CORPUS is not a readable directory%b\n' \
		"$YELLOW" "$NC"
	printf '    SIPNAB_CORPUS=%s\n' "$SIPNAB_CORPUS"
	;;
run)
	# Positional parameters, not a string of arguments: this hook reads its
	# stdin above and never reads "$@", and `set --` keeps shellcheck's
	# word-splitting warning honest instead of silenced.
	set -- --all-features --profile profiling --color never
	corpus_count=0
	for corpus_test in $CORPUS_TESTS; do
		set -- "$@" --test "$corpus_test"
		corpus_count=$((corpus_count + 1))
	done
	printf '  corpus: %d test binaries against %s ... ' "$corpus_count" "$SIPNAB_CORPUS"
	set +e
	CORPUS_OUTPUT=$(cargo test "$@" 2>&1)
	CORPUS_RC=$?
	set -e
	CORPUS_LOG="$CORPUS_LOG_DIR/sipnab-pre-push-corpus.log"
	if [ "$CORPUS_RC" -eq 0 ]; then
		printf '%bVALIDATED%b\n' "$GREEN" "$NC"
		# This log describes the LAST run, not every run that ever failed.
		# Left in place it outlives the failure it records: the gitdir goes
		# on asserting a regression that is already fixed, and the next
		# reader has no way to date it. Two readers took exactly such a
		# stale copy for a live failure before this line existed.
		rm -f "$CORPUS_LOG"
	else
		printf '%bFAIL%b\n' "$RED" "$NC"
		printf '%s\n' "$CORPUS_OUTPUT" > "$CORPUS_LOG"
		# Extractions from here on are greps that may legitimately match
		# nothing, and `set -eu` would turn "matched nothing" into an aborted
		# report -- the defect this section replaces.
		set +e
		# Name the BINARY as well as the test. A dozen binaries share one
		# capture and several carry similarly named cases, so a bare test name
		# does not say which `--test` to re-run. `Running tests/x.rs (...)`
		# precedes each binary's block; `unittests src/lib.rs` is the lib form.
		CORPUS_WHERE=$(printf '%s\n' "$CORPUS_OUTPUT" | awk '
			/^ *Running / { bin = ($2 == "unittests") ? $3 : $2; next }
			/^test .* \.\.\. FAILED$/ {
				name = $0
				sub(/^test /, "", name)
				sub(/ \.\.\. FAILED$/, "", name)
				printf "%s :: %s\n", bin, name
			}')
		CORPUS_FAILED=$(printf '%s\n' "$CORPUS_OUTPUT" \
			| sed -n 's/^test \(.*\) \.\.\. FAILED$/\1/p' | sort -u)
		if [ -n "$CORPUS_FAILED" ]; then
			printf '  %s corpus test(s) failed:\n' \
				"$(printf '%s\n' "$CORPUS_WHERE" | wc -l | tr -d ' ')"
			printf '%s\n' "$CORPUS_WHERE" | emit_capped 10 "$CORPUS_LOG"
			# libtest collects each failure under `---- <name> stdout ----`,
			# which carries the panic location and the assertion message --
			# the two facts that decide whether the break is yours or was
			# already there. Three deep is enough to see a pattern.
			printf '%s\n' "$CORPUS_FAILED" | head -3 | while IFS= read -r corpus_name; do
				corpus_block=$(printf '%s\n' "$CORPUS_OUTPUT" | awk -v pfx="---- $corpus_name " '
					inb && index($0, "---- ") == 1 { exit }
					inb && (/^failures:/ || /^test result:/) { exit }
					index($0, pfx) == 1 { inb = 1; next }
					inb && n == 0 && /^[[:space:]]*$/ { next }
					inb { print; if (++n >= 12) exit }')
				if [ -n "$corpus_block" ]; then
					printf '\n  %s\n' "$corpus_name"
					printf '%s\n' "$corpus_block" | emit_capped 12 "$CORPUS_LOG"
				fi
			done
			CORPUS_SUMMARY=$(printf '%s\n' "$CORPUS_OUTPUT" | grep '^test result: FAILED')
			if [ -n "$CORPUS_SUMMARY" ]; then
				printf '\n'
				printf '%s\n' "$CORPUS_SUMMARY" | emit_capped 5 "$CORPUS_LOG"
			fi
			CORPUS_FIRST=$(printf '%s\n' "$CORPUS_WHERE" | head -1)
			CORPUS_BIN=$(printf '%s\n' "$CORPUS_FIRST" \
				| sed -n 's|^tests/\(.*\)\.rs :: .*$|\1|p')
			CORPUS_NAME=$(printf '%s\n' "$CORPUS_FIRST" | sed -n 's|^.* :: ||p')
			printf '\n'
			if [ -n "$CORPUS_BIN" ]; then
				printf '  Reproduce: SIPNAB_CORPUS=%s cargo test --all-features --profile profiling --test %s %s -- --exact --nocapture\n' \
					"$SIPNAB_CORPUS" "$CORPUS_BIN" "$CORPUS_NAME"
			else
				printf '  Reproduce: SIPNAB_CORPUS=%s cargo test --all-features --profile profiling %s -- --exact --nocapture\n' \
					"$SIPNAB_CORPUS" "$CORPUS_NAME"
			fi
		else
			# No `test ... FAILED` line means the run never got that far. A
			# compile error names a file and a line, so print those; anything
			# else (a signal, a linker failure, an OOM kill) has no structure
			# to key on, so print the tail. The tail beats nothing.
			CORPUS_ERRORS=$(printf '%s\n' "$CORPUS_OUTPUT" \
				| grep -E '^(error|warning)(\[[^]]*\])?:|^ +--> ')
			if [ -n "$CORPUS_ERRORS" ]; then
				printf '  The corpus suite did not build:\n'
				printf '%s\n' "$CORPUS_ERRORS" | emit_capped 20 "$CORPUS_LOG"
			else
				printf '  The run ended without naming a test (exit %s). Last lines:\n' "$CORPUS_RC"
				printf '%s\n' "$CORPUS_OUTPUT" | tail -n 20 | emit_capped 20 "$CORPUS_LOG"
			fi
		fi
		set -e
		printf '  Full output: %s\n' "$CORPUS_LOG"
		printf '\n'
		printf '%bPush blocked: the real capture corpus did not validate.%b\n' "$RED" "$NC"
		printf 'Anything short of 100%% against this corpus is a critical failure.\n'
		printf 'Fix the finding. Do not weaken the test to make the gate quiet --\n'
		printf 'the last time nothing ran this, a test failed on every capture for\n'
		printf 'weeks and the tree looked green the whole time.\n'
		printf '\n'
		printf 'Emergency bypass (discouraged): SKIP_CORPUS_HOOK=1 git push\n'
		exit 1
	fi
	;;
esac
# <<< END corpus-gate

# -- Hard gate: prose linters -------------------------------------------------
# Vale and codespell are CI-blocking and BOTH broke main on 2026-08-03: 12
# passive-voice errors, then two "pre-empt ==> preempt" hits, each caught only
# after the push. Neither is built by cargo, so every local check up to this
# point in the hook passes while CI goes red.
#
# Missing tool reports as NOT CHECKED, never as a pass -- the same rule the
# corpus gate follows, and for the same reason: a gate that goes quiet when its
# tool is absent is worse than no gate, because green then means nothing.
prose_fail=0

printf '  vale (prose style) ... '
if ! command -v vale >/dev/null 2>&1; then
	printf '%bNOT CHECKED -- vale is not installed%b\n' "$YELLOW" "$NC"
	printf '    CI runs it and it blocks. Install from https://vale.sh to check here.\n'
elif vale docs/ website/content/ README.md SUPPORT.md MAINTAINERS.md >/tmp/.sipnab-vale.$$ 2>&1; then
	printf '%bOK%b\n' "$GREEN" "$NC"
	rm -f /tmp/.sipnab-vale.$$
else
	printf '%bFAIL%b\n' "$RED" "$NC"
	tail -40 /tmp/.sipnab-vale.$$
	rm -f /tmp/.sipnab-vale.$$
	prose_fail=1
fi

# CI invokes codespell over this exact path list; keep them identical.
CODESPELL_PATHS="src tests docs website benches harness scripts README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md SUPPORT.md MAINTAINERS.md"
printf '  codespell (spelling) ... '
CS=""
if command -v codespell >/dev/null 2>&1; then
	CS=codespell
elif [ -n "${CODESPELL_BIN:-}" ] && [ -x "${CODESPELL_BIN}" ]; then
	CS="$CODESPELL_BIN"
fi
if [ -z "$CS" ]; then
	printf '%bNOT CHECKED -- codespell is not installed%b\n' "$YELLOW" "$NC"
	printf '    CI runs it and it blocks. `pipx install codespell`, or point\n'
	printf '    CODESPELL_BIN at one in a venv, to check here.\n'
elif $CS $CODESPELL_PATHS --skip ./.git >/tmp/.sipnab-cs.$$ 2>&1; then
	printf '%bOK%b\n' "$GREEN" "$NC"
	rm -f /tmp/.sipnab-cs.$$
else
	printf '%bFAIL%b\n' "$RED" "$NC"
	tail -30 /tmp/.sipnab-cs.$$
	rm -f /tmp/.sipnab-cs.$$
	prose_fail=1
fi

if [ "$prose_fail" -ne 0 ]; then
	printf '\n'
	printf '%bPush blocked: a prose gate CI enforces is failing.%b\n' "$RED" "$NC"
	printf 'Fix the wording rather than reaching for the bypass -- these are the\n'
	printf 'cheapest gates in the set and the two that most recently turned main red.\n'
	printf '\n'
	printf 'Emergency bypass (discouraged): SKIP_FMT_HOOK=1 git push\n'
	exit 1
fi

printf '%bAll required pre-push checks passed.%b\n' "$GREEN" "$NC"
exit 0
