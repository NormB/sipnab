#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: The sipnab contributors

# sipnab pre-commit hook
# Prevents the class of bugs caught by users in this project:
# - Code that compiles but silently doesn't work
# - WASM module out of sync with Rust source
# - A hand-set test count on the homepage (it is generated at deploy)
# - Config keys parsed but never wired

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── The hook must be this checkout's own ─────────────────────────────
# `core.hooksPath` was once an absolute path into one checkout, so every
# worktree ran THAT checkout's branch's hooks. On 2026-09-29 that branch's
# pre-commit lacked the sipnab-bpf-types step, and commits on main went
# through without it -- no error, just a gate that was not there. A hook
# that is not this tree's own would gate with another branch's rules, so it
# refuses. SIPNAB_HOOK_ANY_TREE=1 turns the check off (the hook test
# harnesses need it: they run this file against throwaway trees), and says so.
# The same check opens .githooks/pre-commit and .githooks/pre-push; each
# harness proves its copy.
HOOK_OWN_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
HOOK_TREE=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ "${SIPNAB_HOOK_ANY_TREE:-}" = 1 ]; then
	echo "  Hook belongs to this tree... NOT CHECKED (SIPNAB_HOOK_ANY_TREE=1)"
elif [ -n "$HOOK_TREE" ] && [ "$HOOK_OWN_DIR" != "$(CDPATH='' cd -- "$HOOK_TREE" && pwd -P)/.githooks" ]; then
	echo "This hook is $HOOK_OWN_DIR/$(basename -- "$0"), but the tree being" >&2
	echo "checked is $HOOK_TREE. It would gate it with another checkout's rules." >&2
	echo "Point git at this tree's own hooks:  git config core.hooksPath .githooks" >&2
	exit 1
fi

# ── Prerequisites: the gitignored inputs the gates read ─────────────
# git carries none of them, so a fresh worktree has none. This hook used to
# find them missing deep into its run: pre-commit 25 minutes into the suite
# (52 G.729 tests, crates/g729/test-vectors empty), pre-push at its prose
# gate (no .vale/styles/Google). They are checked first, and each missing one
# is printed with the command that fixes it. The rule is
# scripts/check-hook-prerequisites.py; its G.729 check reads the pins of
# scripts/fetch-g729-vectors.py, so the hook and the fetch cannot disagree.
# Like the same-checkout check above, this is a precondition of running the
# gates, not a gate: CI provisions these inputs itself, so nothing in CI
# mirrors it, and it is not one of the hook's counted gates.
if [ -f scripts/check-hook-prerequisites.py ]; then
	if ! python3 scripts/check-hook-prerequisites.py pre-commit; then
		echo "No gate ran: fetch the missing inputs above, then try again." >&2
		exit 1
	fi
else
	echo "  Prerequisites... NOT CHECKED -- scripts/check-hook-prerequisites.py is not on this branch"
fi

# ── Pass stamps: a check that passed on these exact inputs is not re-run ──
# In the host's heavy-run log from 2026-11-06T13:04Z to 2026-11-07T22:14Z, hook
# runs were 631 of the 1,128 minutes of main-slot run time, and nine times a
# hand run of this hook that passed was followed, from the same directory, by
# `git commit` running it again (40.4 minutes). scripts/gate-cache.py keys each cached step
# on everything it reads -- the index tree, the working tree including
# untracked and ignored files, HEAD and the tags, this file and every script
# under scripts/ and .config/, Cargo.lock, `rustc -Vv`, the nextest, Python,
# vale and codespell versions, and the variables that can change a verdict.
# A step whose key has a stamp prints CACHED and is skipped; any difference in
# the key means it runs. A whole run whose key has a stamp prints one line and
# exits. A stamp is written only after its step passed, and only when the key
# computed again then still matches, so a failed, killed or edited-under run
# writes none. SIPNAB_GATE_NO_CACHE=1 runs every step. The rules, and why the
# suite's key covers every file (the suite reads every tracked file), are in
# that script's docstring; CONTRIBUTING.md has the how-to.
GATE_CACHE="$(dirname "$0")/../scripts/gate-cache.py"
GATE_KEYS=""
if [ ! -f "$GATE_CACHE" ]; then
	echo "  Pass stamps... NOT USED -- scripts/gate-cache.py is not on this branch"
elif ! GATE_KEYS=$(python3 "$GATE_CACHE" keys pre-commit --hook-file "$0"); then
	echo -e "  Pass stamps... ${YELLOW}NOT USED -- scripts/gate-cache.py could not read the inputs; every step runs${NC}"
	GATE_KEYS=""
fi
gate_key() { # gate_key <step>: the step's key, empty when there is none
	printf '%s\n' "$GATE_KEYS" | sed -n "s/^$1 //p"
}
gate_hit() { # gate_hit <step> [--quiet|--line hook]: 0 when a stamp covers the step
	local key
	key=$(gate_key "$1")
	[ -n "$key" ] && python3 "$GATE_CACHE" hit pre-commit "$1" "$key" "${@:2}"
}
# A step that passes is collected here and stamped when the hook exits, all
# from one snapshot (gate-cache.py pass re-checks each key then). One snapshot
# per step made the hook harnesses run past their test deadlines. The exit
# trap also fires on a failure's `exit 1`, so the steps that passed before it
# keep their stamps; a killed run writes none.
GATE_PASSED=()
gate_pass() { # gate_pass <step>: stamp a step that has just passed
	local key
	key=$(gate_key "$1")
	[ -n "$key" ] && GATE_PASSED+=("$1" "$key")
	return 0
}
gate_flush() {
	[ "${#GATE_PASSED[@]}" -gt 0 ] || return 0
	python3 "$GATE_CACHE" pass pre-commit "${GATE_PASSED[@]}" --hook-file "$0" || true
	GATE_PASSED=()
}
trap gate_flush EXIT
if gate_hit hook --line hook; then
	exit 0
fi

# ── The step log: where a run spent its time ───────────────────────────────
# One line per step in <git-dir>/sipnab-pre-commit-steps.log: the run, the
# step as its heading prints it, whole seconds, exit status, tab-separated;
# the last line of a run is the step `total`, counted from the start of this
# shell. `python3 scripts/hook-steps.py` prints the table. On 2026-11-13 the
# table of one 1,191 s run was made by hand from the hook's output.
#
# `step` closes the step that is open with status 0 and opens the next, so a
# step is everything up to the next heading. The exit trap closes the last one
# with the hook's exit status: a step that fails ends the hook. A run a pass
# stamp skipped (above) writes nothing, and a killed run has no `total` line.
# The log is a record, never a gate: a line that cannot be written is dropped.
# A passing suite adds a note, a line of three fields: the run, `nextest`, and
# nextest's Summary line (the tests run, passed and skipped).
STEP_LOG="$(git rev-parse --git-dir 2>/dev/null || echo .)/sipnab-pre-commit-steps.log"
STEP_RUN="$(date -u +%Y-%m-%dT%H:%M:%SZ).$$"
STEP_NAME=""
STEP_T0=0
step_line() { # step_line <step> <seconds> <status>
	{ printf '%s\t%s\t%s\t%s\n' "$STEP_RUN" "$1" "$2" "$3" >> "$STEP_LOG"; } 2>/dev/null || true
}
step_note() { # step_note <name> <text>: a note of this run, three fields, not a step
	[ -n "$2" ] || return 0
	{ printf '%s\t%s\t%s\n' "$STEP_RUN" "$1" "$(printf '%s' "$2" | tr '\t' ' ')" >> "$STEP_LOG"; } 2>/dev/null || true
}
step_close() { # step_close <status>: write the line of the step that is open
	[ -n "$STEP_NAME" ] || return 0
	step_line "$STEP_NAME" "$((SECONDS - STEP_T0))" "$1"
	STEP_NAME=""
}
step() { # step <name>: close the open step as passed, open this one, print its heading
	step_close 0
	STEP_NAME=$1
	STEP_T0=$SECONDS
	printf '  %s... ' "$1"
}
hook_exit() {
	local rc=$?
	step_close "$rc"
	step_line total "$SECONDS" "$rc"
	gate_flush
}
trap hook_exit EXIT
# The log keeps its newest 2,000 lines once it has passed 4,000 (about 180 and
# 90 full runs).
if [ -f "$STEP_LOG" ] && [ "$(wc -l < "$STEP_LOG" 2>/dev/null || echo 0)" -gt 4000 ]; then
	tail -n 2000 "$STEP_LOG" > "$STEP_LOG.cut" 2>/dev/null && mv -f "$STEP_LOG.cut" "$STEP_LOG"
fi
printf '%s\n' "$GATE_KEYS" | sed -n 's/^info //p'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# ── A release-only commit runs the release gates, not the suite ────
# The 0.5.238 release commit f151b38d8 spent 14 minutes here running the whole
# suite on 24 changed lines: the version moving in 13 files and the CHANGELOG
# heading `## [Unreleased]` becoming `## [0.5.238] - 2026-11-08`. The release
# pull request's CI runs the whole suite on the same tree anyway, and that is
# the run the tag gate accepts.
#
# scripts/release-only.py is the rule: a staged change is release-only when
# the [package] version moves forward and every changed line is the old line
# with the version moved, a Since cell of the CLI reference moving from
# `Unreleased`, or that one CHANGELOG heading. Anything else, or anything it
# cannot read, is an ordinary commit and every step runs.
#
# A release-only commit skips the failed-tests replay, clippy, the suite and
# the sipnab-bpf-types tests, and runs the release test targets
# (`release-only.py tests`: the version markers, the Since column, the site
# copies, the CHANGELOG against the tags, the advertised release) in place of
# the suite. Every other step below still runs. SIPNAB_GATE_NO_CACHE=1 runs
# every step.
RELEASE_ONLY=0
if [ "${SIPNAB_GATE_NO_CACHE:-0}" = 0 ] && [ -f scripts/release-only.py ]; then
	if RELEASE_ONLY_LINE=$(python3 scripts/release-only.py staged 2>&1); then
		RELEASE_ONLY=1
		echo "  $RELEASE_ONLY_LINE"
		echo "  Release gates only: the suite, clippy and the replay run in the pull request's CI."
	fi
fi

# ── Naming what failed ─────────────────────────────────────────────
# Gates 1 and 2 must capture their tool's output rather than let it stream:
# gate 5 reads the test run back for the homepage count, and streaming clippy
# would bury the one-line-per-gate summary this hook is built around. Capturing
# it is not license to discard it. Both used to print `FAIL` and a "run it
# yourself" line, so whoever hit it paid for a second full run of the same
# suite just to learn the name of the test — and until that second run finished
# they could not tell whether the break was theirs or already on HEAD. It cost
# an extraction of a pristine HEAD into a scratch directory to settle exactly
# that question once.
#
# So every failure path below prints the part of the capture that names the
# problem, writes the whole capture next to it, and stays bounded: this hook
# runs on every commit and a wall of text is read as carefully as no text.
LOG_DIR=$(git rev-parse --git-dir 2>/dev/null || echo .)

# Print at most <max> lines of stdin, indented, then say how many were withheld
# and where the rest lives.
emit_capped() { # emit_capped <max-lines> <log-path>   (reads stdin)
    local max="$1" log="$2" line n=0 extra=0
    while IFS= read -r line; do
        n=$((n + 1))
        if [ "$n" -le "$max" ]; then
            printf '    %s\n' "$line"
        else
            extra=$((extra + 1))
        fi
    done
    if [ "$extra" -gt 0 ]; then
        printf '    ... %d more line(s) in %s\n' "$extra" "$log"
    fi
}

# ── 0. Formatting must be clean ────────────────────────────────────
# First because it is the cheapest gate in either hook -- measured at 1.4s
# against clippy's minutes -- so an unformatted tree fails in seconds instead
# of after a full lint and test run.
#
# `pre-push` still runs this: that copy is the one that guarantees nothing
# unformatted reaches the remote, and it stays. What it could not do is catch
# the mistake *early*. On 2026-08-06 a one-line import-order slip committed
# cleanly, failed at push, and cost a 40-minute rework cycle -- unwind two
# commits, re-run pre-commit on both, push again -- for a defect this gate
# finds in under two seconds. Formatting is now checked where it is cheap to
# fix, and re-checked where it matters that it is true.
step "Formatting"
set +e
# scripts/check-rustfmt.sh formats every tracked `.rs` file with the dated
# nightly rustfmt in .rustfmt-toolchain, the one rustfmt that applies all of
# rustfmt.toml (the Google Rust Style Guide's options are unstable). Listing
# the files from git reaches `fuzz/` and `bpf/`, which are not workspace
# members: `cargo fmt --all` never saw them, and `bpf/src/main.rs` once sat
# unformatted with five fmt gates green. The script's exit status is the
# signal; its output is the diff.
FMT_OUTPUT=$(
    rc=0
    "$(dirname "$0")/../scripts/check-rustfmt.sh" 2>&1 || rc=1
    exit $rc
)
FMT_RC=$?
set -e
if [ "$FMT_RC" -ne 0 ]; then
    echo -e "${RED}FAIL${NC}"
    FMT_LOG="$LOG_DIR/sipnab-pre-commit-fmt.log"
    printf '%s\n' "$FMT_OUTPUT" > "$FMT_LOG"
    # The diff names the file and line; show a capped slice rather than a
    # whole reformat of a large file.
    printf '%s\n' "$FMT_OUTPUT" | emit_capped 20 "$FMT_LOG"
    echo "  Fix: scripts/check-rustfmt.sh --fix"
    echo "  Full output: $FMT_LOG"
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 0b. The prose gates, where they are cheap to fix ───────────────
# vale and codespell ran only in pre-push, so work that satisfied THIS hook met
# them at the push with the commit already made -- and each rejection costs a
# full gate cycle to redo. It cost two of them on 2026-08-22 alone, one of which
# blocked a release push over a single passive-voice clause.
#
# The same argument formatting already won, one gate up: checked where it is
# cheap to fix, re-checked in pre-push where it matters that it is true. Both
# tools are about a second; this hook's test step is minutes.
#
# pre-push keeps its copies. That is not duplication of the RULE -- resolution,
# the version pin and both path lists live in scripts/prose-gates.sh, sourced by
# all three runners -- only of the decision to run it, which is the point: this
# one is an early warning and that one is the guarantee.
#
# Return 2 is NOT a pass. A commit is not blocked by a missing tool, because CI
# still enforces it and blocking here would make the hook unusable on a machine
# without both; it is reported instead, so nobody reads silence as green.
#
# SOURCED ONLY IF THE BRANCH HAS IT. While `core.hooksPath` was an absolute
# path into one worktree's .githooks/, every worktree and every branch ran
# THAT file while the script it sources is branch content: a branch that
# predated the script, or a `git bisect` across the commit that added it, got
# a hard `No such file or directory` and could not commit at all. hooksPath is
# `.githooks` now, and the first check above refuses a hook from another
# checkout; the skip stays for a hook run by hand against an older tree.
#
# Skipping is the same answer the script gives for a missing tool: the gate did
# not run, and it says so, rather than blocking work it cannot check. pre-push
# and CI still enforce the rule wherever the script exists.
# `|| true` is load-bearing: `set -e` is on, and the exit status of an
# assignment IS the exit status of its command substitution. Outside a
# repository `git rev-parse` exits 128, so the bare form killed the hook
# HERE -- before the `if` below, before vale, before codespell, and before
# the final "checks passed" line. Nothing printed, and the push was refused
# with no message. The NOT CHECKED branch this guard exists to reach was
# unreachable: the script died one line above it.
#
# Exactly the shape that killed both hooks once before, at `prose_vale_run`.
# `2>/dev/null` hides the message, not the status.
PROSE_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
PROSE_LIB="${PROSE_ROOT:-.}/scripts/prose-gates.sh"
prose_commit_fail=0
if [ ! -r "$PROSE_LIB" ]; then
    echo -e "  Vale/Codespell... ${YELLOW}NOT CHECKED -- scripts/prose-gates.sh is not on this branch${NC}"
else
# shellcheck source=scripts/prose-gates.sh
. "$PROSE_LIB"

step "Vale"
# `set -e` is on, and a bare `prose_vale_run` is a simple command: a return of 1
# -- the CONTRACT's "the tool ran and found something" -- killed the hook right
# here, BEFORE the `case` that renders it. The operator saw `Vale... ` and exit
# 1, with the findings written to $PROSE_OUTPUT and then never read. A gate that
# blocks a commit without naming what it found is the "empty output is not
# evidence" shape, in the gate itself.
#
# `&& rc=0 || rc=$?` puts the call in a compound list, where `set -e` is
# suspended, and keeps all three contract values apart -- which a plain
# `if prose_vale_run` would collapse, turning "vale is not installed" into a
# FAIL. Every call of a CONTRACT runner in this repository is spelled this way.
prose_vale_run && prose_rc=0 || prose_rc=$?
case $prose_rc in
0) echo -e "${GREEN}OK${NC}" ;;
1)
    echo -e "${RED}FAIL${NC}"
    emit_capped 20 "$PROSE_OUTPUT" <"$PROSE_OUTPUT"
    echo "  Fix the wording. Reproduce: vale \$(sed 's/#.*//' .config/vale-paths.txt | tr '\n' ' ')"
    prose_commit_fail=1
    ;;
*) echo -e "${YELLOW}NOT CHECKED -- ${PROSE_REASON}${NC}" ;;
esac
rm -f "$PROSE_OUTPUT"

step "Codespell"
# Same shape as vale above, and it failed the same way.
prose_codespell_run && prose_rc=0 || prose_rc=$?
case $prose_rc in
0) echo -e "${GREEN}OK${NC}" ;;
1)
    echo -e "${RED}FAIL${NC}"
    emit_capped 20 "$PROSE_OUTPUT" <"$PROSE_OUTPUT"
    prose_commit_fail=1
    ;;
*) echo -e "${YELLOW}NOT CHECKED -- ${PROSE_REASON}${NC}" ;;
esac
rm -f "$PROSE_OUTPUT"

fi

if [ "$prose_commit_fail" -ne 0 ]; then
    echo
    echo -e "${RED}Commit blocked: a prose gate CI enforces is failing.${NC}"
    echo "These are the cheapest gates in the set and the two that most recently"
    echo "turned main red. Caught here so the push does not cost you a cycle."
    exit 1
fi

# ── Reporting a failed suite run ───────────────────────────────────
# The suite's failure report, for step 2 and for the replay below (0c): the
# names of the failed tests, the first three panics, the summary lines and a
# reproduce line, each capped, and the whole output in <log-path>.
report_suite_failure() { # report_suite_failure <log-path>: reads TEST_OUTPUT and TEST_RC
    printf '%s\n' "$TEST_OUTPUT" > "$1"
    # Extractions from here on are greps that may legitimately match nothing,
    # and an aborted report is the defect this replaced.
    set +e
    FAILED_TESTS=$(printf '%s\n' "$TEST_OUTPUT" \
        | sed -n 's/^test \(.*\) \.\.\. FAILED$/\1/p' | sort -u)
    if [ -n "$FAILED_TESTS" ]; then
        echo "  $(printf '%s\n' "$FAILED_TESTS" | wc -l | tr -d ' ') test(s) failed:"
        printf '%s\n' "$FAILED_TESTS" | emit_capped 10 "$1"
        # libtest collects each failing test's panic under
        # `---- <name> stdout ----`, which carries the panic location and the
        # assertion message — the two facts that decide whether the break is
        # yours or was already there. Three tests deep is enough to see a
        # pattern; the rest is in the log.
        SHOWN=0
        while IFS= read -r t; do
            [ "$SHOWN" -ge 3 ] && break
            SHOWN=$((SHOWN + 1))
            BLOCK=$(printf '%s\n' "$TEST_OUTPUT" | awk -v pfx="---- $t " '
                inb && index($0, "---- ") == 1 { exit }
                inb && (/^failures:/ || /^test result:/) { exit }
                index($0, pfx) == 1 { inb = 1; next }
                inb && n == 0 && /^[[:space:]]*$/ { next }
                inb { print; if (++n >= 12) exit }')
            if [ -n "$BLOCK" ]; then
                echo ""
                echo "  $t"
                printf '%s\n' "$BLOCK" | emit_capped 12 "$1"
            fi
        done <<< "$FAILED_TESTS"
        SUMMARY=$(printf '%s\n' "$TEST_OUTPUT" | grep '^test result: FAILED')
        if [ -n "$SUMMARY" ]; then
            echo ""
            printf '%s\n' "$SUMMARY" | emit_capped 5 "$1"
        fi
        FIRST=$(printf '%s\n' "$FAILED_TESTS" | head -1)
        echo ""
        case "$FIRST" in
        *\ *)
            # A doctest name ("src/lib.rs - foo (line 12)") is not a filter.
            echo "  Reproduce: cargo test --features full --doc"
            ;;
        *)
            echo "  Reproduce: cargo test --features full $FIRST -- --exact --nocapture"
            ;;
        esac
    else
        # No `test ... FAILED` line means the suite never got that far. A
        # compile error names a file and a line, so print those; anything else
        # (a signal, a linker failure, an out-of-memory kill) has no structure
        # to key on, so print the tail. Printing the tail beats printing
        # nothing, which is what this did for every one of these cases.
        BUILD_ERRORS=$(printf '%s\n' "$TEST_OUTPUT" \
            | grep -E '^(error|warning)(\[[^]]*\])?:|^ +--> ')
        if [ -n "$BUILD_ERRORS" ]; then
            echo "  The suite did not build:"
            printf '%s\n' "$BUILD_ERRORS" | emit_capped 20 "$1"
        else
            echo "  The run ended without naming a test (exit $TEST_RC). Last lines:"
            printf '%s\n' "$TEST_OUTPUT" | tail -n 20 | emit_capped 20 "$1"
        fi
        echo "  Reproduce: cargo test --features full"
    fi
    echo "  Full output: $1"
}

# The tests a failed run named, for the next run to replay first (0c).
FAILED_RECORD="$LOG_DIR/sipnab-pre-commit-failed-tests.json"
record_suite_failures() { # record_suite_failures <output-file>
	python3 scripts/parallel-tests.py record-failures "$1" "$FAILED_RECORD" >/dev/null 2>&1 || true
	if [ -s "$FAILED_RECORD" ]; then
		echo "  The next run replays these first (recorded in $FAILED_RECORD)."
	fi
}

# ── 0c. The tests that failed last run, first ──────────────────────
# Any failure used to restart this whole hook, every test included, so
# learning whether a fix worked cost a full suite: in the same log, 18 of 31
# hand runs of this hook failed. The tests the last failed run named (step 2 records them)
# run first, under nextest's --fail-fast, before clippy and the suite. A
# failure stops the hook here. A pass goes on to every step below, the full
# suite included, so a pass still means the full suite passed on this tree.
# scripts/parallel-tests.py --rerun builds the command; a test renamed since
# selects nothing and is not a failure.
if [ "$RELEASE_ONLY" = 0 ] && [ -s "$FAILED_RECORD" ] && ! gate_hit tests --quiet; then
	step "Tests that failed last run, first"
	REPLAY_LIVE="$LOG_DIR/sipnab-pre-commit-replay.live"
	set +e
	env -u SIPNAB_CORPUS -u SIPNAB_VCON_DATASETS python3 scripts/parallel-tests.py --rerun "$FAILED_RECORD" \
		${SIPNAB_TEST_JOBS:+--jobs "$SIPNAB_TEST_JOBS"} -- --features full --color never >"$REPLAY_LIVE" 2>&1
	TEST_RC=$?
	set -e
	TEST_OUTPUT=$(cat "$REPLAY_LIVE")
	rm -f "$REPLAY_LIVE"
	if [ "$TEST_RC" -ne 0 ]; then
		echo -e "${RED}FAIL${NC}"
		echo "  Stopped at the first failure: clippy and the full suite did not run."
		report_suite_failure "$LOG_DIR/sipnab-pre-commit-tests.log"
		exit 1
	fi
	echo -e "${GREEN}OK${NC} (they pass now; the full suite still runs)"
fi

# ── 1. Clippy must pass ────────────────────────────────────────────
# `--color never` so the greps below key on the diagnostic and not on whatever
# CARGO_TERM_COLOR wrapped it in.
# CI'S EXACT COMMAND, byte for byte. It used to be `--features full` on the
# default targets, which lints the lib and the binaries and NOT a single test
# binary -- most of what this repository is. The cost was paid four times: a
# `needless_splitn` in a test file and an `items_after_test_module` in
# `src/sip/mod.rs` on 0.5.135, and twice more on 2026-09-01 in test files
# written that day. Each passed here and failed the command CI runs.
#
# The split was kept because widening it was assumed to "roughly double the
# wall clock". Measured 2026-09-01, warm, on the machine that runs it:
#
#     cargo clippy --features full                          245 ms
#     cargo clippy --workspace --all-features --all-targets  517 ms
#     cargo clippy --features full --all-targets          40,110 ms
#
# The assumption was wrong, and the reason generalizes: CI's command is cheap
# HERE because pre-push and CI already use it, so it shares their build cache.
# The bespoke middle option is 78x slower than the strict one, because a
# feature combination nothing else builds has a cache nothing else warms.
#
# Run the gate, do not approximate it. The approximation was not merely
# weaker; a different one would have been slower too.
# `tests/clippy_scope_parity_test.rs` holds the three scopes equal.
step "Clippy (CI's exact scope)"
# Its stamp's key covers the build inputs only (gate-cache.py's path_class), so
# a change of documentation alone reuses it. The body is not re-indented.
if [ "$RELEASE_ONLY" = 1 ]; then
    echo -e "${YELLOW}SKIPPED${NC} (release-only commit: a version string cannot change a lint; CI runs clippy)"
elif ! gate_hit clippy; then
set +e
CLIPPY_OUTPUT=$(cargo clippy --workspace --all-features --all-targets --color never -- -D warnings 2>&1)
CLIPPY_RC=$?
set -e
if [ "$CLIPPY_RC" -ne 0 ]; then
    echo -e "${RED}FAIL${NC}"
    CLIPPY_LOG="$LOG_DIR/sipnab-pre-commit-clippy.log"
    printf '%s\n' "$CLIPPY_OUTPUT" > "$CLIPPY_LOG"
    # Headline and source location for each diagnostic, in order. This gate
    # used to send clippy's stderr to /dev/null, which is where every
    # diagnostic goes — the lint, the file and the line were all thrown away
    # before anything read them.
    printf '%s\n' "$CLIPPY_OUTPUT" \
        | grep -E '^(error|warning)(\[[^]]*\])?:|^ +--> ' \
        | emit_capped 20 "$CLIPPY_LOG"
    echo "  Reproduce: cargo clippy --workspace --all-features --all-targets -- -D warnings"
    echo "  Full output: $CLIPPY_LOG"
    exit 1
fi
echo -e "${GREEN}OK${NC}"
gate_pass clippy
fi

# ── 2. Tests must pass ─────────────────────────────────────────────
# Capture the full run once: step 5 reuses this exact output for the
# homepage count. Running `cargo test` a second time there could race a
# concurrent cargo on the target dir, abort a binary's compile, drop its
# `test result:` line, and silently undercount. Gate on the exit code so
# a partial/aborted run fails HERE (honestly, "retry") instead of passing
# and feeding step 5 a truncated sum.
step "Tests"
# Its stamp's key covers every file: the suite reads every tracked file. The
# body is not re-indented.
TEST_CACHED=0
if [ "$RELEASE_ONLY" = 1 ]; then
    # The release test targets in place of the suite, without the corpus as
    # the suite runs. Not stamped as the suite: they are not the suite.
    RELEASE_TEST_LOG="$LOG_DIR/sipnab-pre-commit-release-tests.log"
    set +e
    # Word splitting is intended: `release-only.py tests` prints --test flags.
    # shellcheck disable=SC2046
    env -u SIPNAB_CORPUS -u SIPNAB_VCON_DATASETS cargo test --features full --color never \
        $(python3 scripts/release-only.py tests) >"$RELEASE_TEST_LOG" 2>&1
    RELEASE_TEST_RC=$?
    set -e
    if [ "$RELEASE_TEST_RC" -ne 0 ] || grep -q "FAILED\|error\[" "$RELEASE_TEST_LOG"; then
        echo -e "${RED}FAIL${NC} (the release test targets)"
        grep -E '^test .* FAILED|panicked at|^error' "$RELEASE_TEST_LOG" | head -n 20 | sed 's/^/    /' || true
        echo "  Reproduce: cargo test --features full $(python3 scripts/release-only.py tests)"
        echo "  Full output: $RELEASE_TEST_LOG"
        exit 1
    fi
    echo -e "${GREEN}OK${NC} (the release test targets: $(python3 scripts/release-only.py tests | wc -w | awk '{print $1 / 2}'); the suite runs in CI)"
elif gate_hit tests; then
TEST_CACHED=1
else
set +e
# The suite has wedged twice: once for 20 minutes and once left running for
# 1d17h, both at ~0% CPU with every thread sleeping. There was no timeout, and
# the output was captured into a SHELL VARIABLE, so a wedged run wrote nothing
# at all -- and killing it destroyed the only evidence. Both times the cause is
# still unknown, which is precisely why this exists: the next occurrence has to
# leave something behind.
#
# Two changes. Output streams to a file, so a hung run can be tailed while it
# hangs. And a watchdog caps the wall clock, dumping every thread's stack with
# gdb BEFORE killing anything.
#
# The cap is wall-clock, not CPU-flatness, because a hook must stay simple; it
# is set high enough that a cold full-feature build cannot trip it. Override
# with SIPNAB_TEST_TIMEOUT when a machine is genuinely slower.
#
# The suite runs under cargo-nextest, through scripts/parallel-tests.py:
# `cargo nextest run --profile suite`, every test in a process of its own,
# side by side, then the doctests with `cargo test --doc`. The suite profile
# in .config/nextest.toml stops any one test after three 60-second periods
# and fails it by name (TEST-DEADLINE-NEXTEST-SIPNAB), so a hung test no
# longer holds the hook until the watchdog below; the watchdog stays as the
# bound on the whole run. The script renders nextest's report as cargo
# test's text, one block per binary, so everything below reads it
# unchanged. SIPNAB_TEST_JOBS sets nextest's --test-threads (1 = serial).
#
# The tests are nextest's children, not this shell's, so the watchdog below
# walks every descendant rather than direct children only.
#
# The pool runs WITHOUT the private corpus: SIPNAB_CORPUS and
# SIPNAB_VCON_DATASETS are unset for it, so every corpus binary takes its
# skip path and prints its NOTICE. With the shell's SIPNAB_CORPUS inherited,
# every corpus binary replayed the real captures in this DEBUG build on every
# commit: in the 2026-10-23 log the 15 slowest corpus binaries took 1,158.7 s
# of the suite's 1,882.7 s. .githooks/pre-push drives every binary that
# reads either variable, against the corpus, under the optimized `corpus`
# profile, so the corpus runs once per push instead (decided 2026-10-27).
# `env -u` rather than `VAR=`: an empty SIPNAB_CORPUS is a corpus at "" to
# tests/support/corpus.rs, not an unset one. scripts/test-pre-commit.sh
# (Scenario 1c) reads the environment the suite was handed.
TEST_LIVE="$LOG_DIR/sipnab-pre-commit-tests.live"
: >"$TEST_LIVE"
env -u SIPNAB_CORPUS -u SIPNAB_VCON_DATASETS python3 scripts/parallel-tests.py ${SIPNAB_TEST_JOBS:+--jobs "$SIPNAB_TEST_JOBS"} \
	-- --features full --color never >"$TEST_LIVE" 2>&1 &
TEST_PID=$!
descendants() { # every process below $1, depth first
	for _c in $(pgrep -P "$1" 2>/dev/null); do
		echo "$_c"
		descendants "$_c"
	done
}
TEST_DEADLINE=$(( $(date +%s) + ${SIPNAB_TEST_TIMEOUT:-1800} ))
TEST_WEDGED=0
while kill -0 "$TEST_PID" 2>/dev/null; do
	if [ "$(date +%s)" -ge "$TEST_DEADLINE" ]; then
		TEST_WEDGED=1
		STACKS="$LOG_DIR/sipnab-test-wedge-stacks.txt"
		: >"$STACKS"
		# /proc FIRST, because it always works. gdb needs ptrace, and under
		# the default yama ptrace_scope=1 a process may only attach to its
		# own DESCENDANTS -- this gdb is a SIBLING of the test binary, so it
		# cannot attach and says "Could not attach to process". Proved by
		# running this watchdog with SIPNAB_TEST_TIMEOUT=10: the gdb-only
		# version produced a stacks file containing nothing but that error,
		# which is worse than no file because it looks like evidence.
		#
		# The /proc fields below are the ones that actually identified the
		# wedge by hand: per-thread `comm` names the test that is stuck, and
		# `wchan` plus State distinguish "blocked in the kernel" from
		# "spinning in userspace". Both sightings were State=S at ~0% CPU.
		#
		# ---- Two arms, because every probe above is Linux-only -------------
		# Measured 2026-08-19 on macOS 26.5.2 / aarch64: `/proc` does not
		# exist, so the status and per-thread loops read nothing; `ps --ppid`
		# is a GNU long option and BSD ps answers `ps: illegal option -- -`;
		# and gdb is not installed (on macOS it also needs codesigning, so
		# installing it would not have helped). The whole collector therefore
		# wrote a file containing pid headers, an empty thread section and a
		# ps usage message -- which is precisely the "worse than no file
		# because it looks like evidence" outcome the paragraph above rejects
		# for the gdb-only version. It mattered here more than anywhere: the
		# 1d17h sighting this watchdog exists for was on a Mac, so on the one
		# host that has produced the defect, the evidence collector was inert.
		#
		# The Darwin arm collects the same three things by the native route:
		#
		#   /bin/ps -M          per-thread STAT/PRI/CPU -- the analogue of the
		#                       /proc/<pid>/task walk, and the same S-at-0%
		#                       signature is what both sightings showed.
		#   pgrep -P + /bin/ps  children. `pgrep -P` is BSD as well as GNU
		#                       (verified), so only the ps invocation differs.
		#   sample              per-thread backtraces, and the one that makes
		#                       this arm worth having: it is the piece gdb
		#                       could never deliver on Linux. `sample` reads a
		#                       live task without ptrace and without
		#                       privileges for a process the same user owns,
		#                       so unlike the gdb branch it is expected to
		#                       SUCCEED, not to fail with a permissions
		#                       message. Verified against a live victim: it
		#                       reported the blocking kernel call
		#                       (`__semwait_signal`) per thread, which is the
		#                       `wchan` column by another name. Bounded to 2s
		#                       (measured: 2s wall) so a wedged suite with
		#                       many test binaries cannot turn the watchdog
		#                       into its own hang.
		#
		# The dispatch is on `/proc` being real rather than on `uname`, so a
		# host with neither falls to the final arm and SAYS it collected
		# nothing instead of leaving an empty section to be misread.
		for p in $(descendants "$TEST_PID"); do
			{
				echo "===== pid $p ====="
				if [ -d "/proc/$p" ]; then
					sed -n 's/^\(Name\|State\|Threads\|PPid\):/\1:/p' "/proc/$p/status" 2>/dev/null
					echo "--- threads: tid comm wchan ---"
					for t in /proc/$p/task/*; do
						printf '%s\t%s\t%s\n' "${t##*/}" \
							"$(cat "$t/comm" 2>/dev/null)" \
							"$(cat "$t/wchan" 2>/dev/null)"
					done
					echo "--- children (zombies are normal: event_exec reaps lazily) ---"
					ps --ppid "$p" -o pid,stat,etime,comm 2>&1
					if command -v gdb >/dev/null 2>&1; then
						echo "--- gdb backtraces (needs ptrace_scope=0 or root; expected to fail otherwise) ---"
						gdb -p "$p" -batch -ex 'set pagination off' \
							-ex 'thread apply all bt' 2>&1
					fi
				elif [ "$(uname -s)" = "Darwin" ]; then
					echo "--- threads: ps -M (STAT S at ~0% CPU is the wedge signature) ---"
					/bin/ps -M -p "$p" 2>&1
					echo "--- children (zombies are normal: event_exec reaps lazily) ---"
					KIDS=$(pgrep -P "$p" 2>/dev/null | tr '\n' ' ')
					if [ -n "$KIDS" ]; then
						# Word-splitting on $KIDS is intended: -p takes a list.
						# shellcheck disable=SC2086
						/bin/ps -o pid,stat,etime,comm -p $KIDS 2>&1
					else
						echo "(none)"
					fi
					if command -v sample >/dev/null 2>&1; then
						echo "--- sample: per-thread backtraces (2s) ---"
						sample "$p" 2 -f /dev/stdout 2>&1
					else
						echo "--- no /usr/bin/sample: no backtraces collected ---"
					fi
				else
					echo "--- $(uname -s) has no /proc and no sample(1):"
					echo "    NOTHING was collected for this pid. Do not read the"
					echo "    absence of a stuck thread here as evidence of one."
				fi
			} >>"$STACKS"
		done
		# The whole tree, listed BEFORE any kill: a killed parent's
		# children are re-parented and would drop out of a later walk.
		TEST_TREE=$(descendants "$TEST_PID")
		kill -9 "$TEST_PID" $TEST_TREE 2>/dev/null
		break
	fi
	# One second, not five: the loop is also how the hook learns the suite
	# ended, and every run waited up to the whole interval for it. Against
	# scripts/lib-hook-sandbox.sh's stub suite this step took 5.3 s with a
	# five-second poll and 1.3 s with this one (measured 2026-11-07).
	#
	# The second is now ten looks 0.1 s apart that stop when the suite has
	# ended, so the deadline above is still read once a second and the hook
	# leaves within 0.1 s of the suite. With one sleep of a whole second a
	# sandboxed run of this hook spent 1.00 s of its 2.24 s here (measured
	# 2026-11-11), the harnesses run the hook dozens of times, and the two
	# tests of tests/hook_test_scripts_git_env_test.rs that run a whole
	# harness passed nextest's 180 s deadline on a loaded host.
	# scripts/test-pre-commit.sh's Scenario W holds the 0.1 s.
	_look=0
	while [ "$_look" -lt 10 ] && kill -0 "$TEST_PID" 2>/dev/null; do
		sleep 0.1
		_look=$((_look + 1))
	done
done
wait "$TEST_PID"
TEST_RC=$?
TEST_OUTPUT=$(cat "$TEST_LIVE")
if [ "$TEST_WEDGED" -eq 1 ]; then
	echo -e "${RED}WEDGED${NC}"
	echo "  The suite made no progress for ${SIPNAB_TEST_TIMEOUT:-1800}s and was killed."
	echo "  Thread stacks: $STACKS"
	echo "  Partial output: $TEST_LIVE"
	echo "  This is a known, unreproduced defect -- please keep both files."
	record_suite_failures "$TEST_LIVE"
	exit 1
fi
set -e
if [ "$TEST_RC" -ne 0 ] || echo "$TEST_OUTPUT" | grep -q "FAILED\|error\["; then
    echo -e "${RED}FAIL${NC}"
    TEST_LOG="$LOG_DIR/sipnab-pre-commit-tests.log"
    report_suite_failure "$TEST_LOG"
    record_suite_failures "$TEST_LOG"
    exit 1
fi
echo -e "${GREEN}OK${NC}"
# nextest's Summary line of this passing run, as a note in the step log: the
# suite's total was kept only for a failed run (in sipnab-pre-commit-tests.log),
# so two passing runs could not be compared by their totals.
step_note nextest "$(printf '%s\n' "$TEST_OUTPUT" | sed -n 's/^[[:space:]]*\(Summary \[.*\)$/\1/p' | tail -n 1)"
# Passed: nothing is left to replay. The count step (5) needs this run's
# output; it is read here, so the stamp vouches for both, and step 5 reports it.
rm -f "$FAILED_RECORD"
COUNT_RC=0
COUNT_OUT=$(printf '%s\n' "$TEST_OUTPUT" | python3 scripts/published-test-count.py - 2>&1) || COUNT_RC=$?
if [ "$COUNT_RC" -eq 0 ]; then
    gate_pass tests
fi
fi

# ── 2b. The sipnab-bpf-types crate's own tests and doctests ────────
# Step 2 tests the sipnab package only: `cargo test` without `-p` or
# `--workspace` leaves the other members out. sipnab-bpf-types is published,
# its README is its docs.rs front page, and the examples on it are doctests
# that assert how a perf sample is read. Nothing ran them before this step, so
# a broken example would have reached crates.io unnoticed. Kept out of step 2's
# log on purpose: the homepage count is sipnab's suite, and CI counts the same.
step "sipnab-bpf-types tests and doctests"
# A build-only key: the crate reads nothing at run time outside crates/, and
# its README, which its doctests come from, is an include_str! input.
if [ "$RELEASE_ONLY" = 1 ]; then
    echo -e "${YELLOW}SKIPPED${NC} (release-only commit; CI runs them)"
elif gate_hit bpf-types; then
    :
elif BPF_TYPES_OUT=$(cargo test -p sipnab-bpf-types --no-fail-fast --color never 2>&1); then
    echo -e "${GREEN}OK${NC}"
    gate_pass bpf-types
else
    echo -e "${RED}FAIL${NC}"
    printf '%s\n' "$BPF_TYPES_OUT" | grep -E 'FAILED|panicked|^error' | head -n 20 || true
    echo "  Reproduce: cargo test -p sipnab-bpf-types --no-fail-fast"
    exit 1
fi

# ── 3. No unwrap()/expect()/panic!/unreachable! in production code ─
step "No unwrap/expect/panic in production"
# The script's EXIT STATUS is the signal; it prints offenders to stderr.
if ! UNWRAP_OUT=$(python3 scripts/check-unwrap.py 2>&1); then
    echo -e "${RED}FAIL${NC}"
    echo "$UNWRAP_OUT"
    echo "Found unwrap()/expect()/panic!/unreachable!/todo!/unimplemented! in"
    echo "production code. Return an error instead, or -- for a site that"
    echo "genuinely cannot be reached -- say why on the line above it:"
    echo "  // gate: <macro> because <reason>"
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 3z. A generated file is staged with the inputs it derives from ─
# Runs FIRST of the source-reading gates, because it is the only one that can
# see the difference between this commit and the working tree. `main` broke
# four times in one session on that difference: a feature matrix built from the
# worktree, a testing matrix regenerated against a stale binary, the same file
# regenerated from a tree holding other agents' unfinished work, and a link
# ratchet raised for documentation that never got committed.
#
# No later gate can catch it. They all read the worktree, where the tree is
# self-consistent -- coverage_matrix_test passed locally both times it was
# wrong. Only the index knows what is actually being committed.
step "Generated files staged with their inputs"
if ! STAGED_OUT=$(python3 scripts/check-generated-inputs-staged.py 2>&1); then
    echo -e "${RED}FAIL${NC}"
    echo "$STAGED_OUT"
    echo "Stage the input alongside the generated file, or unstage the"
    echo "generated file. A committed artifact must describe the commit."
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 3a. Every feature declares what its own modules import ────────
# `--features vcon` did not build at 0.5.130: src/output/redact.rs is gated by
# any(api, mcp, vcon) and imports hmac, and only two of those three features
# declared dep:hmac. `--features full` hid it, because mcp supplies hmac
# anyway, so every ordinary build passed while one matrix combination failed.
#
# The feature matrix (then in pre-push, now CI's Features job) exists for
# exactly this and still missed it: the hook's copy built the WORKING TREE, and the working tree held the fix while the
# commit did not. This reads the source, so it answers about what is written
# rather than about what happens to be checked out, in milliseconds rather
# than eleven compilations.
step "Features declare their modules' imports"
if ! FEATDEP_OUT=$(python3 scripts/check-feature-deps.py 2>&1); then
    echo -e "${RED}FAIL${NC}"
    echo "$FEATDEP_OUT"
    echo "A feature-gated module imports a crate its feature does not declare."
    echo "Add the missing dep: entry to that feature in Cargo.toml."
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 3b. The privilege-drop path still drops privileges ────────────
# Runs BEFORE the expensive gates, and reads source rather than running it.
# On 2026-08-05 a mutation-testing pass left four controls disabled at once in
# src/privilege.rs -- PR_SET_DUMPABLE swapped for PR_GET_DUMPABLE behind an
# `if false &&`, the chdir("/") after chroot() deleted, and both
# drop_supplementary_groups() and set_no_new_privs() removed. Every one of those
# still COMPILES and still passes every test that does not specifically cover
# it, so clippy and the suite both stayed green while the process kept its
# capabilities. A text scan is the only check that also answers when the tree
# does not build, which is exactly when a half-restored mutation hides behind an
# unrelated compile error.
step "Privilege drop intact"
if ! PRIV_OUT=$(python3 scripts/check-privilege-drop.py 2>&1); then
    echo -e "${RED}FAIL${NC}"
    echo "$PRIV_OUT"
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 3c. The fuzz targets build the dependency versions that ship ──
# fuzz/Cargo.lock is a second lockfile for the sipnab crate's dependencies,
# and Dependabot resolves it on its own (until 2026-11-10 in a pull request
# of its own; now in the root lockfile's pull request). On 2026-11-08 it
# held a different version than Cargo.lock for 39 of the 214 crates the two
# share (clap 4.6.7 against 4.6.3, cc 1.4.0 against 1.2.59), so the fuzz
# targets fuzzed dependency code the binary does not ship, and no gate said
# so. Reads the two lockfiles, in milliseconds. CI's Security audit job runs
# the same script.
step "Fuzz lockfile matches Cargo.lock"
if ! DRIFT_OUT=$(python3 scripts/check-lockfile-drift.py 2>&1); then
    echo -e "${RED}FAIL${NC}"
    echo "$DRIFT_OUT" | tail -12 | sed 's/^/    /'
    echo "  Every line: python3 scripts/check-lockfile-drift.py"
    echo "  Align each line with the cargo update it names, or record an"
    echo "  exception with its reason. How-to: CONTRIBUTING.md,"
    echo "  \"Keeping fuzz/Cargo.lock aligned with Cargo.lock\"."
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 4. WASM module in sync with source ────────────────────────────
step "WASM exports in sync"
if [ -f "website/static/wasm/sipnab.js" ]; then
    # The export list is DERIVED from src/wasm.rs by the script, not restated
    # here. This gate used to carry a hand-kept list of twelve names, duplicated
    # byte-for-byte in tests/wasm_exports_test.rs, while src/wasm.rs exported
    # sixteen — so renaming three of the four unlisted ones in the built glue
    # passed both and committed. A hand-kept list cannot catch a NEW function,
    # which is exactly what the guard claims to be for.
    if ! WASM_CHECK=$(python3 scripts/check-wasm-exports.py 2>&1); then
        echo -e "${RED}FAIL${NC}"
        echo "  $WASM_CHECK"
        echo "  Rebuild: wasm-pack build --target web --out-dir website/static/wasm --no-typescript -- --no-default-features --features wasm"
        exit 1
    fi
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${YELLOW}SKIP (no WASM build)${NC}"
fi

# ── Backlog status summary is current ──────────────────────────────
# The file carries several hundred checkbox items. The per-item convention is
# readable and the aggregate is not, so a generated table answers "what is left
# in this section" without scrolling. Generated, because a hand-kept count is
# wrong the first time somebody ticks a box.
# The local backlog is gitignored, so it never appears in the index: trigger on
# the file existing instead of on it being staged.
if [ -f "docs/design/backlog.local.md" ]; then
    step "Backlog status"
    if python3 scripts/backlog-status.py >/dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAIL${NC}"
        echo "  The status table no longer matches the items below it."
        echo "  Fix: python3 scripts/backlog-status.py --apply"
        exit 1
    fi
fi

# ── Harness client tests ───────────────────────────────────────────
# Python, and outside the cargo suite, so nothing else runs them. They pin
# defects that already shipped once -- a correlation join against fields that
# do not exist, an SSE reader that took the keepalive, a guard that compared
# nothing. Untested-by-default code rots.
# ── RFC citations linked ───────────────────────────────────────────
# Every commit, not only one that stages `scripts/`. The first-mention rule
# was enforced only by the script tests, which run here when `scripts/` is
# staged, so a docs-only commit with an unlinked `RFC N` passed this hook and
# failed CI. Check mode exits 1 when `--apply` would change anything.
step "RFC citations linked"
if command -v python3 >/dev/null 2>&1; then
    if RFC_OUT=$(python3 scripts/rfc-links.py 2>&1); then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAIL${NC}"
        echo "$RFC_OUT" | tail -12 | sed 's/^/    /'
        echo "  Fix: python3 scripts/rfc-links.py --apply, then stage the result"
        exit 1
    fi
else
    echo -e "${YELLOW}SKIP (python3 absent)${NC}"
fi

# ── Script tests ───────────────────────────────────────────────────
# Twenty Python scripts had no tests at all, and several of them are the
# fixers the gates below depend on. A fixer that stops producing what its gate
# demands turns every commit into a manual repair.
#
# Every commit, not only one that stages `scripts/`: the tests read files
# outside it (test_advertise_release.py reads docs/install.md and
# website/config.toml), so a commit that staged only docs/install.md passed
# this hook and failed CI on two heads (c1223c892, 21537ddd1). The gate cache
# keys this step on the whole tree, so a second run on an unchanged tree is a
# hit. Measured 2026-11-11: 2040 tests, 268 s at a load average near 25.
# scripts/test-pre-commit.sh's Scenario S drives this step.
step "Script tests"
if [ ! -d scripts/tests ]; then
    echo -e "${YELLOW}NOT RUN (this tree has no scripts/tests)${NC}"
elif [ "$RELEASE_ONLY" = 1 ]; then
    # As before this step ran on every commit: a release-only commit stages
    # nothing under scripts/, so it never ran them. CI does.
    echo -e "${YELLOW}NOT RUN (release-only commit; CI runs them)${NC}"
else
    if command -v python3 >/dev/null 2>&1 && python3 -c "import pytest" 2>/dev/null; then
        if gate_hit script-tests; then
            :
        elif SCRIPT_OUT=$(cd scripts && python3 -m pytest tests/ -q 2>&1); then
            echo -e "${GREEN}OK${NC} ($(echo "$SCRIPT_OUT" | tail -1))"
            gate_pass script-tests
        else
            echo -e "${RED}FAIL${NC}"
            echo "$SCRIPT_OUT" | tail -12 | sed 's/^/    /'
            echo "  Reproduce: cd scripts && python3 -m pytest tests/"
            exit 1
        fi
    else
        echo -e "${YELLOW}SKIP (pytest absent)${NC}"
    fi
fi

if git diff --cached --name-only | grep -q "^clients/python/"; then
    step "Python clients"
    if command -v python3 >/dev/null 2>&1 && python3 -c "import pytest" 2>/dev/null; then
        if PYTEST_OUT=$(python3 -m pytest clients/python/tests/ -q 2>&1); then
            echo -e "${GREEN}OK${NC} ($(echo "$PYTEST_OUT" | tail -1))"
        else
            echo -e "${RED}FAIL${NC}"
            echo "$PYTEST_OUT" | tail -12 | sed 's/^/    /'
            echo "  Reproduce: python3 -m pytest clients/python/tests/"
            exit 1
        fi
    else
        echo -e "${YELLOW}SKIP (pytest absent)${NC}"
    fi
fi

# ── 5. Homepage test count is generated, not committed ─────────────
# The homepage's automated-test count used to be a number in
# website/templates/index.html that this gate held to the step-2 run. Every
# pull request that added a test edited it, so any two such pull requests
# conflicted on it. pages.yml now writes it at deploy time, from CI's Linux
# `cargo test --all-features` run, with scripts/published-test-count.py.
#
# What is left to check here is the mechanism, in milliseconds: the rule
# still counts a real run (the validated step-2 output, NOT a fresh `cargo
# test`, which could race a concurrent cargo and undercount), the template
# still reads the generated file, and no literal count has come back. The
# step-2 run is `--features full`, CI's is `--all-features`;
# no_test_hides_behind_a_feature_outside_full in tests/site_journey_test.rs
# keeps them the same suite.
step "Homepage test count generated"
if [ -f "website/templates/index.html" ]; then
    # COUNT_OUT and COUNT_RC are step 2's reading of its own run. A suite
    # skipped by its stamp was counted by the run that wrote the stamp: the
    # stamp is written only when that count succeeded.
    if [ "$RELEASE_ONLY" = 1 ]; then
        COUNT_OUT="not counted: a release-only commit runs the release test targets, not the suite"
    elif [ "$TEST_CACHED" = 1 ]; then
        COUNT_OUT="counted when stamp $(gate_key tests | cut -c1-12) was written"
    elif [ "$COUNT_RC" -ne 0 ]; then
        echo -e "${RED}FAIL${NC}"
        echo "  $COUNT_OUT"
        echo "  scripts/published-test-count.py cannot count the step-2 run, so the"
        echo "  deploy could not count CI's either."
        exit 1
    fi
    if ! grep -qF 'load_data(path="data/test-count.toml", required=false)' website/templates/index.html; then
        echo -e "${RED}FAIL${NC}"
        echo "  website/templates/index.html no longer loads data/test-count.toml,"
        echo "  the file pages.yml generates the test count into."
        exit 1
    fi
    if LITERAL=$(grep -oiE '[0-9][0-9,]* automated tests' website/templates/index.html); then
        echo -e "${RED}FAIL${NC}"
        echo "  website/templates/index.html states a literal test count: $LITERAL"
        echo "  The count is generated at deploy time. Use {{ suite.automated_tests }}."
        exit 1
    fi
    echo -e "${GREEN}OK ($COUNT_OUT)${NC}"
else
    echo -e "${YELLOW}SKIP (no website)${NC}"
fi

# ── 5b. Site version matches the crate version ─────────────────────
# The homepage version badge and the (version-pinned) download links read
# website/config.toml [extra] version. Keep it equal to the Cargo.toml crate
# version so the site never advertises a stale release. (CI's Pages build also
# re-derives it from Cargo.toml; this gate catches drift before it ships.)
step "Site version matches crate"
if [ -f "website/config.toml" ]; then
    CRATE_V=$(grep -m1 '^version = ' Cargo.toml | sed -E 's/version = "(.*)"/\1/')
    SITE_V=$(grep -m1 '^version = ' website/config.toml | sed -E 's/version = "(.*)"/\1/')
    if [ -n "$CRATE_V" ] && [ "$CRATE_V" != "$SITE_V" ]; then
        echo -e "${RED}FAIL${NC}"
        echo "  website/config.toml version is $SITE_V but Cargo.toml is $CRATE_V"
        echo "  Update [extra] version in website/config.toml to $CRATE_V"
        exit 1
    fi
    echo -e "${GREEN}OK ($SITE_V)${NC}"
else
    echo -e "${YELLOW}SKIP (no website)${NC}"
fi

# ── 5c. (removed) Man/docs version strings ────────────────────────────────
# This step used to re-implement tests/docs_drift_test.rs's
# docs_current_version_markers_match_cargo in shell: its own file list, its own
# combined regex, its own idea of which markers matter.
#
# Two implementations of one rule, with nothing keeping them in sync, and they
# did diverge. website/content/docs/benchmarks.md was deliberately dropped from
# the Rust list -- that page names the release the numbers were MEASURED on,
# which must NOT follow the crate version -- but this copy still listed it, and
# rejected a correct release commit over an "as of 0.5.47" that was meant to be
# historical.
#
# The shell copy was also strictly the weaker of the two: it never checked
# either mcp-walkthrough page, nor the `sipnab X.Y.Z (` form in the install
# docs. It could only ever fail on something the Rust test already catches, or
# fail on something the Rust test had deliberately excused.
#
# Step 2 above runs `cargo test --features full`, which executes both
# docs_current_version_markers_match_cargo and
# man_page_version_and_license_match_cargo (verified: they appear in that run).
# So this coverage is not lost -- it is now asserted in exactly one place, by
# the implementation that also runs in CI.

# ── 6. No TODO stubs in production code ────────────────────────────
step "No TODO stubs"
# `--include` not `-g`: `-g` is a ripgrep/ugrep flag. Under GNU grep it is an
# invalid option, the error was swallowed by 2>/dev/null, and the count came
# back 0 unconditionally — so this gate silently passed on any machine where
# `grep` was GNU grep rather than ugrep. `--include` works in both.
TODO_COUNT=$(grep -rn "TODO\|FIXME" --include='*.rs' src/ 2>/dev/null | grep -v test | grep -v '_test.rs' | wc -l | tr -d ' ')
if [ "$TODO_COUNT" != "0" ]; then
    echo -e "${YELLOW}WARN: $TODO_COUNT TODO/FIXME comments${NC}"
else
    echo -e "${GREEN}OK${NC}"
fi

# ── 7. WASM bundle: the binary is no longer committed ─────────────
#
# This used to demand a rebuilt `sipnab_bg.wasm` alongside any `src/wasm.rs`
# change. That gate is gone with the binary it guarded, for two reasons that
# both point the same way.
#
# It did not work. The published analyzer went eleven releases stale while
# this stayed green, because `src/wasm.rs` had no commits in that window: the
# interface held still while the implementation behind it moved. The Pages
# workflow now builds the bundle at deploy time, so what ships is generated
# rather than committed and cannot go stale — the argument is written out in
# .github/workflows/pages.yml.
#
# And a committed binary is a finding in its own right. OpenSSF Scorecard's
# Binary-Artifacts check flagged it at high severity, correctly: a binary in a
# repository is not auditable from its source.
#
# `sipnab.js` stays committed. It is text, Scorecard does not flag it, and the
# export guard below reads it — see `scripts/check-wasm-exports.py`.

# ── 8. Developer docs cite code — flag edits to cited files ────────
step "Developer-docs coupling"
staged=$(git diff --cached --name-only)
if ! echo "$staged" | grep -q '^docs/internals/'; then
    cited=$(grep -rhoE '\]\((\.\./)+[a-zA-Z0-9_./-]+\)' docs/internals/*.md 2>/dev/null \
        | sed -E 's/^\]\(//; s/\)$//; s#(\.\./)+##' | sort -u)
    hits=$(comm -12 <(echo "$staged" | sort -u) <(echo "$cited"))
    if [ -n "$hits" ]; then
        echo -e "${YELLOW}REVIEW${NC}"
        echo "  These staged files are cited by the developer docs:"
        echo "$hits" | sed 's/^/    /'
        echo "  Confirm docs/internals/ still reads true, then re-commit."
        echo "  (Advisory — the hard gate is dev_docs_drift_test in CI.)"
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK${NC}"
fi

gate_pass hook
echo -e "${GREEN}All pre-commit checks passed.${NC}"
