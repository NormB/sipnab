#!/usr/bin/env bash
# sipnab pre-commit hook
# Prevents the class of bugs caught by users in this project:
# - Code that compiles but silently doesn't work
# - WASM module out of sync with Rust source
# - Test count on homepage stale
# - Config keys parsed but never wired

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# ── 1. Clippy must pass ────────────────────────────────────────────
echo -n "  Clippy... "
if ! cargo clippy --features full -- -D warnings 2>/dev/null; then
    echo -e "${RED}FAIL${NC}"
    echo "Fix clippy warnings before committing."
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 2. Tests must pass ─────────────────────────────────────────────
# Capture the full run once: step 5 reuses this exact output for the
# homepage count. Running `cargo test` a second time there could race a
# concurrent cargo on the target dir, abort a binary's compile, drop its
# `test result:` line, and silently undercount. Gate on the exit code so
# a partial/aborted run fails HERE (honestly, "retry") instead of passing
# and feeding step 5 a truncated sum.
echo -n "  Tests... "
set +e
TEST_OUTPUT=$(cargo test --features full 2>&1)
TEST_RC=$?
set -e
if [ "$TEST_RC" -ne 0 ] || echo "$TEST_OUTPUT" | grep -q "FAILED\|error\["; then
    echo -e "${RED}FAIL${NC}"
    echo "Tests are failing or the run did not complete. Run: cargo test --features full"
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 3. No unwrap()/expect() in production code ────────────────────
echo -n "  No unwrap/expect in production... "
UNWRAP_COUNT=$(python3 -c "
import os
count = 0
for root, dirs, files in os.walk('src'):
    for f in files:
        if not f.endswith('.rs') or f.endswith('_test.rs'):
            continue
        path = os.path.join(root, f)
        in_test = False
        with open(path) as fh:
            for i, line in enumerate(fh, 1):
                stripped = line.strip()
                if stripped == '#[cfg(test)]' or stripped.startswith('mod tests'):
                    in_test = True
                if in_test:
                    continue
                if stripped.startswith('///') or stripped.startswith('//!'):
                    continue
                if '.unwrap()' in line or '.expect(' in line:
                    count += 1
                    print(f'  {path}:{i}: {stripped}', file=__import__('sys').stderr)
print(count)
" 2>&1)
if [ "$UNWRAP_COUNT" != "0" ]; then
    echo -e "${RED}FAIL${NC}"
    echo "Found unwrap()/expect() in production code. Use ? or match instead."
    exit 1
fi
echo -e "${GREEN}OK${NC}"

# ── 4. WASM module in sync with source ────────────────────────────
echo -n "  WASM exports in sync... "
if [ -f "website/static/wasm/sipnab.js" ]; then
    WASM_CHECK=$(python3 -c "
js = open('website/static/wasm/sipnab.js').read()
required = ['load_pcap', 'get_dialogs', 'get_call_flow', 'get_raw_message',
            'filter', 'export_json', 'export_csv', 'export_mermaid',
            'get_streams', 'get_stream_detail', 'stream_count', 'rtp_packet_count']
missing = [fn for fn in required if fn + '(' not in js]
if missing:
    print('MISSING: ' + ', '.join(missing))
else:
    print('OK')
")
    if [[ "$WASM_CHECK" != "OK" ]]; then
        echo -e "${RED}FAIL${NC}"
        echo "  $WASM_CHECK"
        echo "  Rebuild: wasm-pack build --target web --out-dir website/static/wasm --no-typescript -- --no-default-features --features wasm"
        exit 1
    fi
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${YELLOW}SKIP (no WASM build)${NC}"
fi

# ── 5. Homepage test count matches actual ──────────────────────────
# Two independent places on the homepage carry the test count: the stat card
# (data-count, anchored here to its "Automated tests" label rather than to
# position so adding another stat can't silently mis-target it) and the prose
# "N automated tests" in the feature table. Both must equal the real count.
echo -n "  Homepage test count... "
if [ -f "website/templates/index.html" ]; then
    # Reuse the validated step-2 run (TEST_RC==0 guarantees every binary
    # reported), NOT a fresh `cargo test` — a second run can race a
    # concurrent cargo and undercount. Sum the passed column of every
    # `test result:` line (lib + integration + doctests).
    ACTUAL=$(echo "$TEST_OUTPUT" | grep "test result:" | awk '{sum += $4} END {print sum}')
    STAT=$(grep -B1 'Automated tests' website/templates/index.html | grep -o 'data-count="[0-9]*"' | grep -o '[0-9]*' | head -1)
    PROSE=$(grep -oE '[0-9]+ automated tests' website/templates/index.html | grep -oE '[0-9]+' | sort -u)
    if [ -n "$ACTUAL" ]; then
        for FOUND in $STAT $PROSE; do
            if [ "$FOUND" != "$ACTUAL" ]; then
                echo -e "${RED}FAIL${NC}"
                echo "  Homepage shows $FOUND tests but actual count is $ACTUAL"
                echo "  Update website/templates/index.html (stat card + prose)"
                exit 1
            fi
        done
    fi
    echo -e "${GREEN}OK ($ACTUAL)${NC}"
else
    echo -e "${YELLOW}SKIP (no website)${NC}"
fi

# ── 5b. Site version matches the crate version ─────────────────────
# The homepage version badge and the (version-pinned) download links read
# website/config.toml [extra] version. Keep it equal to the Cargo.toml crate
# version so the site never advertises a stale release. (CI's Pages build also
# re-derives it from Cargo.toml; this gate catches drift before it ships.)
echo -n "  Site version matches crate... "
if [ -f "website/config.toml" ]; then
    CRATE_V=$(grep -m1 '^version = ' Cargo.toml | sed -E 's/version = "(.*)"/\1/')
    SITE_V=$(grep -m1 '^version = ' website/config.toml | sed -E 's/version = "(.*)"/\1/')
    if [ -n "$CRATE_V" ] && [ "$CRATE_V" != "$SITE_V" ]; then
        echo -e "${RED}FAIL${NC}"
        echo "  website/config.toml version is $SITE_V but Cargo.toml is $CRATE_V"
        echo "  Update [extra] version in website/config.toml to $CRATE_V"
        exit 1
    fi
    echo -e "${GREEN}OK ($SITE_V)${NC}"
else
    echo -e "${YELLOW}SKIP (no website)${NC}"
fi

# ── 5c. (removed) Man/docs version strings ────────────────────────────────
# This step used to re-implement tests/docs_drift_test.rs's
# docs_current_version_markers_match_cargo in shell: its own file list, its own
# combined regex, its own idea of which markers matter.
#
# Two implementations of one rule, with nothing keeping them in sync, and they
# did diverge. website/content/docs/benchmarks.md was deliberately dropped from
# the Rust list -- that page names the release the numbers were MEASURED on,
# which must NOT follow the crate version -- but this copy still listed it, and
# rejected a correct release commit over an "as of 0.5.47" that was meant to be
# historical.
#
# The shell copy was also strictly the weaker of the two: it never checked
# either mcp-walkthrough page, nor the `sipnab X.Y.Z (` form in the install
# docs. It could only ever fail on something the Rust test already catches, or
# fail on something the Rust test had deliberately excused.
#
# Step 2 above runs `cargo test --features full`, which executes both
# docs_current_version_markers_match_cargo and
# man_page_version_and_license_match_cargo (verified: they appear in that run).
# So this coverage is not lost -- it is now asserted in exactly one place, by
# the implementation that also runs in CI.

# ── 6. No TODO stubs in production code ────────────────────────────
echo -n "  No TODO stubs... "
# `--include` not `-g`: `-g` is a ripgrep/ugrep flag. Under GNU grep it is an
# invalid option, the error was swallowed by 2>/dev/null, and the count came
# back 0 unconditionally — so this gate silently passed on any machine where
# `grep` was GNU grep rather than ugrep. `--include` works in both.
TODO_COUNT=$(grep -rn "TODO\|FIXME" --include='*.rs' src/ 2>/dev/null | grep -v test | grep -v '_test.rs' | wc -l | tr -d ' ')
if [ "$TODO_COUNT" != "0" ]; then
    echo -e "${YELLOW}WARN: $TODO_COUNT TODO/FIXME comments${NC}"
else
    echo -e "${GREEN}OK${NC}"
fi

# ── 7. Check for staged wasm.rs changes without WASM rebuild ──────
echo -n "  WASM rebuild check... "
if git diff --cached --name-only | grep -q "src/wasm.rs"; then
    if ! git diff --cached --name-only | grep -q "website/static/wasm/sipnab"; then
        echo -e "${RED}FAIL${NC}"
        echo "  src/wasm.rs changed but website/static/wasm/ not updated."
        echo "  Rebuild: wasm-pack build --target web --out-dir website/static/wasm --no-typescript -- --no-default-features --features wasm"
        exit 1
    fi
fi
echo -e "${GREEN}OK${NC}"

# ── 8. Developer docs cite code — flag edits to cited files ────────
echo -n "  Developer-docs coupling... "
staged=$(git diff --cached --name-only)
if ! echo "$staged" | grep -q '^docs/internals/'; then
    cited=$(grep -rhoE '\]\((\.\./)+[a-zA-Z0-9_./-]+\)' docs/internals/*.md 2>/dev/null \
        | sed -E 's/^\]\(//; s/\)$//; s#(\.\./)+##' | sort -u)
    hits=$(comm -12 <(echo "$staged" | sort -u) <(echo "$cited"))
    if [ -n "$hits" ]; then
        echo -e "${YELLOW}REVIEW${NC}"
        echo "  These staged files are cited by the developer docs:"
        echo "$hits" | sed 's/^/    /'
        echo "  Confirm docs/internals/ still reads true, then re-commit."
        echo "  (Advisory — the hard gate is dev_docs_drift_test in CI.)"
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK${NC}"
fi

echo -e "${GREEN}All pre-commit checks passed.${NC}"
