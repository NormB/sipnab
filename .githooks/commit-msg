#!/usr/bin/env bash
# sipnab commit-msg hook
# A commit message is published the moment the commit is pushed, and it stays
# in the history after any later fix. This refuses a message that names the
# lab's development host, its machines, its DNS domain, its LAN or an account
# path, using the same rules that scan the tracked files
# (tests/private_identity_test.rs), through scripts/check-message-identity.sh.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── The hook must be this checkout's own ─────────────────────────────
# The same check as .githooks/pre-commit and .githooks/pre-push: a hook that
# is not this tree's own would check the message with another branch's rules.
# SIPNAB_HOOK_ANY_TREE=1 turns the check off, and says so.
HOOK_OWN_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
HOOK_TREE=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ "${SIPNAB_HOOK_ANY_TREE:-}" = 1 ]; then
	echo "  Hook belongs to this tree... NOT CHECKED (SIPNAB_HOOK_ANY_TREE=1)"
elif [ -n "$HOOK_TREE" ] && [ "$HOOK_OWN_DIR" != "$(CDPATH='' cd -- "$HOOK_TREE" && pwd -P)/.githooks" ]; then
	echo "This hook is $HOOK_OWN_DIR/$(basename -- "$0"), but the tree being" >&2
	echo "checked is $HOOK_TREE. It would gate it with another checkout's rules." >&2
	echo "Point git at this tree's own hooks:  git config core.hooksPath .githooks" >&2
	exit 1
fi

# ── The message names no private identity ─────────────────────────────
# A branch that predates the script skips with a NOT CHECKED line rather than
# failing, the same answer pre-commit gives for scripts/prose-gates.sh.
# `|| true` keeps `set -e` from ending the hook outside a repository.
MSG_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
MSG_CHECK="${MSG_ROOT:-.}/scripts/check-message-identity.sh"
echo -n "  Commit message names no private identity... "
if [ ! -r "$MSG_CHECK" ]; then
	echo -e "${YELLOW}NOT CHECKED -- scripts/check-message-identity.sh is not on this branch${NC}"
	exit 0
fi

# `&& rc=0 || rc=$?` keeps `set -e` from ending the hook before the result
# is printed.
MSG_OUT=$(bash "$MSG_CHECK" "$1" 2>&1) && rc=0 || rc=$?
case $rc in
0) echo -e "${GREEN}OK${NC}" ;;
1)
	echo -e "${RED}FAIL${NC}"
	printf '%s\n' "$MSG_OUT"
	echo "  Reword the message, then commit again. Reproduce: scripts/check-message-identity.sh <file>"
	exit 1
	;;
*)
	# Could not check: refused rather than passed, because a message nobody
	# read is not a clean message.
	echo -e "${RED}FAIL -- the check did not run${NC}"
	printf '%s\n' "$MSG_OUT"
	exit 1
	;;
esac
