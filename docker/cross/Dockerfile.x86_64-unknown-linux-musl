FROM ghcr.io/cross-rs/x86_64-unknown-linux-musl:main@sha256:b7452ab0229ccaf49fd17b207f148bb470362a8da3fdb903b332fbfc819367fc

# libpcap is built from source against musl because the released musl artifact
# links it statically; the distro copy is glibc-linked and unusable here.
#
# 1.10.6 rather than 1.10.5: only 1.10.6 mentions netmap in
# `pcap_lib_version()` (upstream CHANGES: "Mind netmap support in
# pcap_lib_version()"). On 1.10.5 the backend is compiled in but invisible, so
# nothing downstream can assert it is present. 1.10.6 also makes DPDK opt-in.
#
# netmap is the only alternate capture backend that can ship in a static musl
# binary: BSD-2-Clause and header-only, so there is no library to link and
# nothing to break full static linking. DPDK is not an option — upstream
# pcap-dpdk.c states libdpdk can only be linked dynamically, and libpcap 1.11
# removes the module entirely. libpcap has no AF_XDP/XDP module in any release.
#
# The netmap headers are pinned to a commit for the same reason the base image
# and the libpcap tarball are pinned: `master` is not a version.
#
# The sha256 of each pinned input is recorded next to it. A pin that names WHICH
# bytes without checking WHICH bytes arrived is only a request, and until
# 0.5.120 that is all these were: two mutable hosts, no integrity check of any
# kind. Both values were confirmed against a second, independent source before
# being written down, because a checksum copied from the same download it is
# meant to police proves nothing:
#
#   netmap  — `git hash-object` of each downloaded header equals the blob SHA-1
#             GitHub's tree API reports for that path at NETMAP_COMMIT, so the
#             bytes are the ones the pinned commit names.
#   libpcap — the .tar.gz beside this .tar.xz in the same release directory
#             matches the sha512 Alpine's aports records for libpcap 1.10.6,
#             which is a pin made elsewhere, by someone else, from a different
#             download.
ARG LIBPCAP_VERSION=1.10.6
ARG LIBPCAP_SHA256=ec97d1206bdd19cb6bdd043eaa9f0037aa732262ec68e070fd7c7b5f834d5dfc
# luigirizzo/netmap tag v13.0.
ARG NETMAP_COMMIT=6d3a00936a7dfae50d97b9f90d5f05bff235c86c
ARG NETMAP_H_SHA256=169a5c7b0c75f0e77d9525dc465b3306c30c1f786d7ce5130edca82f6e06de28
ARG NETMAP_USER_H_SHA256=16ffbe85c2734a361e04111ba6747926df5c16dc86c6daa1bab4702e9f7d1887
ARG NETMAP_LEGACY_H_SHA256=8e29140cd3330b3d86e1ee15fc1ff9d5753fec21e0b8cdaee86886d42a3d80a0
ARG MUSL_PREFIX=/usr/local/x86_64-linux-musl

# EVERYTHING BELOW IS SPLIT INTO ONE RUN PER STAGE, AND THAT IS THE POINT.
#
# This was a single `&&` chain: install tools, fetch headers, fetch tarball,
# configure, make, assert. On 2026-08-21 the 0.5.120 release build failed on
# the netmap headers, and because Docker quotes the WHOLE failing instruction,
# the message it printed led with `apt-get install ...` — a command that had
# already succeeded. It named the wrong thing to look at, on a build whose tag
# was already public: `Create Release` and the Homebrew bump are `needs:
# build`, so v0.5.120 existed with no artefacts behind it until the job was
# re-run by hand.
#
# One RUN per stage means the instruction Docker quotes is the one that failed.
# The cost is that the tarball survives in an intermediate layer instead of
# being removed in the same command (~680 KB in an image nothing publishes).
# `no_cross_image_instruction_mixes_a_download_with_a_build` in
# tests/ci_local_fetch_gate_test.rs keeps them split.

# Acquire::Retries and the timeouts, because the archives are the host that
# hung for fifteen minutes on 2026-08-20 and canceled a CI run outright. apt
# will not retry or give up on its own.
RUN timeout 300 apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && timeout 600 apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y flex bison wget xz-utils \
    && rm -rf /var/lib/apt/lists/*

# fetch-pinned <url> <dest> <sha256> — the only way anything is downloaded here.
#
# Three properties, each earned by a specific failure:
#
#   BOUNDED   `timeout 300` wraps wget itself. wget's own --timeout bounds a
#             stalled read; it does not bound wget, and a host that accepts the
#             connection and then trickles would otherwise hold the build until
#             timeout-minutes killed the job with nothing useful in the log.
#   RETRIED   --tries=5 with --waitretry backoff, and --retry-connrefused so a
#             refused connection is retried rather than treated as final. A
#             transient stall is what actually happens; a sustained outage is
#             not fixable here and is reported as itself.
#   VERIFIED  sha256sum against the pin above, BEFORE the bytes are used. A
#             truncated or substituted header used to surface as a compiler
#             error deep inside libpcap, which reads as "our build is broken".
#
# The two failure messages are deliberately different. A transfer failure says
# re-run; a checksum mismatch says do NOT re-run, because a host serving bytes
# other than the pinned ones is not a transient condition and re-running is how
# a substitution gets accepted on the second try.
RUN { \
      echo '#!/bin/sh'; \
      echo '# fetch-pinned <url> <dest> <sha256>. Generated by docker/cross/Dockerfile.*'; \
      echo 'set -eu'; \
      echo 'url="$1"; dest="$2"; want="$3"; rc=0'; \
      echo 'timeout 300 wget -q -O "$dest" --tries=5 --timeout=30 --waitretry=15 --retry-connrefused "$url" || rc=$?'; \
      echo 'if [ "$rc" != 0 ]; then'; \
      echo '  rm -f "$dest"'; \
      echo '  echo "" >&2'; \
      echo '  echo "FETCH FAILED (this is NOT a build failure): $url" >&2'; \
      echo '  if [ "$rc" = 124 ]; then'; \
      echo '    echo "  wget was killed at the 300s bound: the host accepted the" >&2'; \
      echo '    echo "  connection and then stopped sending." >&2'; \
      echo '  else'; \
      echo '    echo "  wget exited $rc after 5 attempts with backoff." >&2'; \
      echo '  fi'; \
      echo '  echo "  The command that failed is wget. No sipnab source was compiled" >&2'; \
      echo '  echo "  and nothing in this repository is broken. Re-run the job." >&2'; \
      echo '  exit 1'; \
      echo 'fi'; \
      echo 'if ! echo "$want  $dest" | sha256sum -c - >/dev/null 2>&1; then'; \
      echo '  echo "" >&2'; \
      echo '  echo "FETCH CORRUPT (this is NOT a build failure): $url" >&2'; \
      echo '  echo "  served sha256 $(sha256sum "$dest" | cut -d" " -f1)" >&2'; \
      echo '  echo "  pinned sha256 $want" >&2'; \
      echo '  echo "  Re-running will NOT fix this. Either a version or commit ARG" >&2'; \
      echo '  echo "  above was bumped without its sha256, or the host served bytes" >&2'; \
      echo '  echo "  other than the ones this image pins. Establish which before" >&2'; \
      echo '  echo "  editing the pin to match whatever arrived." >&2'; \
      echo '  rm -f "$dest"'; \
      echo '  exit 1'; \
      echo 'fi'; \
      echo 'echo "fetch-pinned ok: $url"'; \
    } > /usr/local/bin/fetch-pinned \
    && chmod 0755 /usr/local/bin/fetch-pinned

RUN mkdir -p "${MUSL_PREFIX}/include/net" \
    && fetch-pinned "https://raw.githubusercontent.com/luigirizzo/netmap/${NETMAP_COMMIT}/sys/net/netmap.h" "${MUSL_PREFIX}/include/net/netmap.h" "${NETMAP_H_SHA256}" \
    && fetch-pinned "https://raw.githubusercontent.com/luigirizzo/netmap/${NETMAP_COMMIT}/sys/net/netmap_user.h" "${MUSL_PREFIX}/include/net/netmap_user.h" "${NETMAP_USER_H_SHA256}" \
    && fetch-pinned "https://raw.githubusercontent.com/luigirizzo/netmap/${NETMAP_COMMIT}/sys/net/netmap_legacy.h" "${MUSL_PREFIX}/include/net/netmap_legacy.h" "${NETMAP_LEGACY_H_SHA256}"

RUN fetch-pinned "https://www.tcpdump.org/release/libpcap-${LIBPCAP_VERSION}.tar.xz" "/tmp/libpcap-${LIBPCAP_VERSION}.tar.xz" "${LIBPCAP_SHA256}"

# `-include sys/types.h` is load-bearing, not defensive: net/netmap_user.h uses
# `u_int`/`u_char` and pcap-netmap.c does not pull in sys/types.h first, which
# musl (unlike glibc) does not paper over. Without it `make` fails. `configure`
# reports "netmap support ... yes" either way because its probe compiles with
# AC_INCLUDES_DEFAULT, so a green configure proves nothing. `-D_GNU_SOURCE`
# alone does not fix it. Setting CFLAGS replaces libpcap's own default, so
# `-g -O2` is restated to avoid silently building unoptimized.
#
# The `ar t` assertion is the actual gate: if netmap ever stops compiling in,
# the image build fails here rather than shipping a binary quietly missing it.
#
# Nothing in this instruction reaches a network. If it fails, the build failed.
RUN cd /tmp \
    && tar xf "libpcap-${LIBPCAP_VERSION}.tar.xz" \
    && cd "libpcap-${LIBPCAP_VERSION}" \
    && CC=x86_64-linux-musl-gcc \
       CFLAGS="-g -O2 -I${MUSL_PREFIX}/include -include sys/types.h" \
       ./configure --host=x86_64-linux-musl --prefix="${MUSL_PREFIX}" \
                   --disable-shared --without-libnl --enable-netmap \
    && make -j$(nproc) \
    && make install \
    && ar t "${MUSL_PREFIX}/lib/libpcap.a" | grep -qx 'pcap-netmap.o' \
    && cd / && rm -rf "/tmp/libpcap-${LIBPCAP_VERSION}" "/tmp/libpcap-${LIBPCAP_VERSION}.tar.xz"
