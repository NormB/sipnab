{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sipnab.com/schemas/call_report.schema.json",
  "title": "sipnab call report / full dialog (DialogJson)",
  "description": "Serialized form of DialogJson (src/output/json.rs): the `--call-report --json` output and GET /v1/dialogs/{id}. The embedded `streams` items mirror stream.schema.json (kept self-contained, no cross-file $ref).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "state",
    "method",
    "msg_count",
    "duration_sec",
    "timing",
    "sdp_timeline",
    "diagnosis",
    "streams"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "call_id": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "from_display": {
      "type": "string"
    },
    "to_display": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "final_status_code": {
      "type": "integer"
    },
    "final_status_reason": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "msg_count": {
      "type": "integer",
      "minimum": 0
    },
    "duration_sec": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "sdp_timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sdp_exchange"
      }
    },
    "diagnosis": {
      "$ref": "#/$defs/diagnosis"
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "signaling_diagnosis": {
      "$ref": "#/$defs/signaling_diagnosis"
    },
    "icmp_media": {
      "$ref": "#/$defs/icmp_media"
    },
    "frame": {
      "type": "string",
      "description": "Pointer to the frame this dialog opened in, as `<source>#<ordinal>@<digest>`. Follow it with `sipnab --show-frame`, which checks the digest and refuses when the capture changed since the pointer was made. Optional, and absent rather than null when the dialog has no frame (live capture): absent means unknown, and a value that is present is always a real pointer.",
      "pattern": "^.+#[0-9]+(@[0-9a-f]{16})?$"
    },
    "input_origin": {
      "type": "string",
      "enum": [
        "wire",
        "hep",
        "uprobe"
      ],
      "description": "Which capture source delivered the message that OPENED this dialog. First, never latest: one process can capture from an interface and a HEP mirror at once, and with no BPF filter excluding the mirrored signaling ports the same message arrives from both, so a field reassigned per message would report whichever spoke last. Absent rather than null when the opening message came from no captured packet."
    }
  },
  "$defs": {
    "icmp_media": {
      "type": "object",
      "additionalProperties": false,
      "description": "What ICMP said about this capture's MEDIA. Keyed by the quoted datagram's own 5-tuple, not by Call-ID, because a media datagram carries none — so this is a different question from signaling_diagnosis.icmp_unreachable and the two are never merged. Omitted entirely when the capture drew no ICMP quoting non-SIP traffic. `capture` is capture-wide and travels with every dialog so a reader of one call can see that evidence exists; `findings` holds only the findings whose attribution named THIS dialog.",
      "required": [
        "capture"
      ],
      "properties": {
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "description": "Run-wide outcome counters. Three separate outcomes, never collapsed: attributed + unattributed == errors, and sum(finding.errors) + unkeyed + untracked_flows == errors.",
          "required": [
            "errors",
            "media",
            "attributed",
            "unattributed",
            "unkeyed",
            "untracked_flows",
            "untallied_endpoints",
            "flows"
          ],
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "media": {
              "type": "integer",
              "minimum": 0
            },
            "attributed": {
              "type": "integer",
              "minimum": 0
            },
            "unattributed": {
              "type": "integer",
              "minimum": 0
            },
            "unkeyed": {
              "type": "integer",
              "minimum": 0
            },
            "untracked_flows": {
              "type": "integer",
              "minimum": 0
            },
            "untallied_endpoints": {
              "type": "integer",
              "minimum": 0
            },
            "flows": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/icmp_media_finding"
          }
        }
      }
    },
    "icmp_media_finding": {
      "type": "object",
      "additionalProperties": false,
      "description": "One quoted flow the network reported as undeliverable.",
      "required": [
        "attribution",
        "source",
        "unreachable_endpoint",
        "reported_by",
        "transport",
        "description",
        "icmp_type",
        "icmp_code",
        "errors",
        "payload",
        "streams",
        "hint"
      ],
      "properties": {
        "attribution": {
          "description": "Which rule tied this flow to tracked media. REQUIRED and enumerated: the five tiers are not equally strong claims — `flow` is an exact directed 5-tuple match, `none` is no match at all — and a consumer that cannot tell them apart would present a guess with the confidence of a measurement. A finding without this field is worse than no finding.",
          "enum": [
            "flow",
            "ssrc",
            "endpoint",
            "sdp_endpoint",
            "none"
          ]
        },
        "source": {
          "type": "string"
        },
        "unreachable_endpoint": {
          "type": "string"
        },
        "reported_by": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icmp_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "icmp_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "errors": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "description": "What the router quoted, as opposed to what sipnab tied it to. A quote can be unmistakably RTP and match nothing, or match a stream exactly with no payload left to read.",
          "enum": [
            "rtp",
            "rtcp",
            "unread",
            "not_media"
          ]
        },
        "payload_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "rtcp_packet_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ssrc": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{8}$"
        },
        "streams": {
          "type": "integer",
          "minimum": 0
        },
        "call_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retransmits"
      ],
      "properties": {
        "pdd_ms": {
          "type": "integer"
        },
        "setup_ms": {
          "type": "integer"
        },
        "ring_ms": {
          "type": "integer"
        },
        "trying_delay_ms": {
          "type": "integer"
        },
        "teardown_ms": {
          "type": "integer"
        },
        "retransmits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sdp_exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "direction",
        "codecs",
        "mode"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "direction": {
          "type": "string"
        },
        "codecs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "media_addr": {
          "type": "string"
        },
        "media_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "mode": {
          "type": "string"
        },
        "event": {
          "type": "string"
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_way_audio",
        "nat_mismatch",
        "no_media",
        "private_media_address",
        "hints"
      ],
      "properties": {
        "one_way_audio": {
          "type": "boolean"
        },
        "nat_mismatch": {
          "type": "boolean"
        },
        "no_media": {
          "type": "boolean"
        },
        "private_media_address": {
          "type": "boolean"
        },
        "media_relay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client",
            "server",
            "channel",
            "lapsed"
          ],
          "properties": {
            "client": {
              "type": "string"
            },
            "server": {
              "type": "string"
            },
            "relayed_address": {
              "type": "string"
            },
            "channel": {
              "type": "integer",
              "minimum": 16384,
              "maximum": 32767
            },
            "peer": {
              "type": "string"
            },
            "lapsed": {
              "type": "boolean"
            }
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ssrc",
        "payload_type",
        "src",
        "dst",
        "packets",
        "octets",
        "jitter_ms",
        "loss_pct",
        "orphaned",
        "first_seen",
        "last_seen",
        "quality_intervals"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ssrc": {
          "type": "string"
        },
        "codec": {
          "type": "string"
        },
        "payload_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "src": {
          "type": "string"
        },
        "dst": {
          "type": "string"
        },
        "packets": {
          "type": "integer",
          "minimum": 0
        },
        "octets": {
          "type": "integer",
          "minimum": 0
        },
        "jitter_ms": {
          "type": "number"
        },
        "loss_pct": {
          "type": "number"
        },
        "orphaned": {
          "type": "boolean"
        },
        "associated_dialog": {
          "type": "string"
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "quality_intervals": {
          "type": "array"
        },
        "burst_gap": {
          "type": "object"
        },
        "frame": {
          "type": "string",
          "description": "Pointer to the frame this stream's first packet arrived in, as `<source>#<ordinal>@<digest>`. Follow it with `sipnab --show-frame`, which checks the digest and refuses when the capture changed since the pointer was made. Optional, and absent rather than null when the stream has no frame (live capture): absent means unknown, and a value that is present is always a real pointer."
        },
        "dscp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63,
          "description": "DSCP of this stream's FIRST packet (RFC 2474). Absent rather than null when no IP header was observed (a HEP-fed stream), so absent means unknown and 0 means observed best effort."
        },
        "dscp_last": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63,
          "description": "DSCP of this stream's most recent packet, present ONLY when it differs from `dscp` — the stream was re-marked in flight."
        },
        "input_origin": {
          "type": "string",
          "enum": [
            "wire",
            "hep",
            "uprobe"
          ],
          "description": "Which capture source this stream's MEDIA arrived over. Absent rather than null when the stream came from no captured packet."
        },
        "dialog_origin": {
          "type": "string",
          "enum": [
            "wire",
            "hep",
            "uprobe"
          ],
          "description": "Which source delivered the SDP that named this stream's dialog, present ONLY when it differs from `input_origin` — the binding crossed capture sources. A cross-source tie is weaker than a same-source one: the SDP says what the proxy believes it did and the media says what the NIC saw, and the two can disagree. Absent means either a same-source binding or one whose sources nobody recorded, never 'they agree'."
        }
      }
    },
    "signaling_diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Signaling-side diagnosis. Every detection is optional and absent means checked-and-not-detected; the whole object is omitted when nothing fired.",
      "required": [
        "hints"
      ],
      "properties": {
        "final_failure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "reason_phrase",
                "evidence"
              ],
              "properties": {
                "code": {
                  "type": "integer"
                },
                "reason_phrase": {
                  "type": "string"
                },
                "reason_header": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "warning": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "auth_loop": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "challenges",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "credential_failure",
                    "silent_drop"
                  ]
                },
                "challenges": {
                  "type": "integer"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "retransmissions": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "count",
                "span_sec",
                "evidence"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "span_sec": {
                  "type": "number"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "icmp_cause": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "ack_missing": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "waited_sec",
                "answer_transmissions",
                "evidence"
              ],
              "properties": {
                "waited_sec": {
                  "type": "number"
                },
                "answer_transmissions": {
                  "type": "integer"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "abandoned": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "elapsed_sec",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "canceled",
                    "no_final_response"
                  ]
                },
                "elapsed_sec": {
                  "type": "number"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "post_dial_delay": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "delay_sec",
                "threshold_sec",
                "responded_with",
                "evidence"
              ],
              "properties": {
                "delay_sec": {
                  "type": "number"
                },
                "threshold_sec": {
                  "type": "number"
                },
                "responded_with": {
                  "type": "integer"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "registration_failure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "code",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "rejected",
                    "shortened_expiry"
                  ]
                },
                "code": {
                  "type": "integer"
                },
                "requested_expiry_sec": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "granted_expiry_sec": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "icmp_unreachable": {
          "description": "An ICMP/ICMPv6 error quoting one of this dialog's requests. Omitted entirely (not null) when absent, because the check can only run on a capture that holds ICMP at all: null would claim it ran. `unreachable_endpoint` is the socket that did not answer; `reported_by` is the router or host that reported it, which is a different address and is not the fault. `truncated` says the quote sipnab read was a prefix of the original datagram, which RFC 792 permits and most routers do.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "icmp_type",
                "icmp_code",
                "unreachable_endpoint",
                "reported_by",
                "errors",
                "truncated",
                "evidence"
              ],
              "properties": {
                "description": {
                  "type": "string"
                },
                "icmp_type": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "icmp_code": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "unreachable_endpoint": {
                  "type": "string"
                },
                "reported_by": {
                  "type": "string"
                },
                "method": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "errors": {
                  "type": "integer",
                  "minimum": 1
                },
                "truncated": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
