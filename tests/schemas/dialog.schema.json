{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sipnab.com/schemas/dialog.schema.json",
  "title": "sipnab dialog summary (GET /v1/dialogs list item)",
  "description": "Serialized form of output::model::DialogSummary — the canonical compact dialog projection shared by the REST API, MCP, and TUI-save surfaces (WS3). One element of the `dialogs` array; the list wrapper carries schema_version/total/offset/limit. WS3 wire change: `from`/`to` became `from_user`/`to_user`, and `timing` gained `duration_ms`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "call_id",
    "state",
    "method",
    "duration_sec",
    "msg_count",
    "timing",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "call_id": { "type": "string" },
    "from_user": { "type": ["string", "null"] },
    "to_user": { "type": ["string", "null"] },
    "state": { "type": "string" },
    "method": { "type": "string" },
    "duration_sec": { "type": "number" },
    "msg_count": { "type": "integer", "minimum": 0 },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retransmits"],
      "properties": {
        "pdd_ms": { "type": ["integer", "null"] },
        "setup_ms": { "type": ["integer", "null"] },
        "retransmits": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
