# Copy to .env and adjust. `make up` / docker compose read this automatically.

COMPOSE_PROJECT_NAME=sipnab-harness

# ---- Network ----------------------------------------------------------------
SIPNET_SUBNET=172.28.0.0/24
OPENSIPS_IP=172.28.0.10
UAS_IP=172.28.0.20
UAC_IP=172.28.0.21

# ---- Published ports (host side) -------------------------------------------
# Internal ports are fixed (opensips on 5060, rtpengine 30000-30050). These
# are the HOST-side published ports -- change them if the host already runs a
# service on the default (e.g. a host OpenSIPS on udp/5060).
SIP_HOST_PORT=5060     # host port -> opensips-1:5060 (laptop registers/calls here)
MCP_PORT=8731          # host port -> sipnab MCP HTTP (laptop agent connects here)
RTP_MIN=30000          # rtpengine media range (published udp), keep <= RTP_MAX
RTP_MAX=30050

# ---- sipnab MCP -------------------------------------------------------------
# Host header the MCP server will accept. The laptop reaches this box by IP or
# DNS name; rmcp's DNS-rebind guard rejects unknown Host values. Set this to
# your host's name/IP, or leave "*" (host-check disabled) and rely on the
# bearer token + a network firewall. The token is ALWAYS required on the
# non-loopback bind regardless of this value.
SIPNAB_MCP_ALLOWED_HOST=*

# Token rotation. sipnab serves short-lived bearer tokens minted from the
# long-lived signing key (secrets/mcp.signing-key) and re-mints them on a timer.
# Keep ROTATE_INTERVAL <= TTL/2 so the published token always has comfortable
# remaining validity. Larger values = fewer laptop re-pulls; smaller = more
# frequent rotation (heavier dogfooding of the expiry path).
SIPNAB_MCP_TOKEN_TTL=600        # minted-token lifetime, seconds
SIPNAB_MCP_ROTATE_INTERVAL=300  # re-mint cadence, seconds

# ---- OpenSIPS source --------------------------------------------------------
# Upstream, pinned to a release tag. A contributor who runs this harness gets
# what everyone else gets, so a bug they reproduce is a bug in OpenSIPS rather
# than in a fork's patches.
#
# Override to build from a fork or a branch:
#   OPENSIPS_GIT_URL=https://github.com/NormB/opensips.git
#   OPENSIPS_GIT_REF=d8586fa6
OPENSIPS_GIT_URL=https://github.com/OpenSIPS/opensips.git
OPENSIPS_GIT_REF=3.6.7

# ---- Traffic generator ------------------------------------------------------
LOOP_PAUSE=5           # seconds between UAC scenario iterations

# Address the harness publishes its SIP/MCP/RTP ports on.
#
# Loopback by default, deliberately: on 0.0.0.0 this stack is an open SIP
# service that answers calls from anyone who can route to the host, and it has
# been found doing exactly that. Set it to this host's LAN address to reach the
# harness from a laptop. Do not set it to 0.0.0.0.
HARNESS_BIND=127.0.0.1
