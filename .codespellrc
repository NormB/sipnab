[codespell]
# Typo detection across code, tests, docs and the harness.
#
# Scope first: the initial run reported 2,880 findings, of which 2,504 came from
# one vendored minified bundle (website/static/js/mermaid.min.js) and the rest
# largely from build artifacts under fuzz/target. Minified and generated files
# have no prose to check and will never be edited by hand, so the signal only
# appears once they are out.
#
# skip = */node_modules/*,*/e2e/test-results/*,package-lock.json,build output, vendored/minified assets, binary fixtures, and the two
# kinds of file whose content is deliberately truncated:
#   tests/snapshots/  insta snapshots of TUI frames, clipped to terminal width,
#                     so "FAILE" and "fo" are the rendered output, not typos
#   tests/cli/out/    trycmd transcripts, same reason ("Fro" from a cut hexdump)
#   THIRD-PARTY-NOTICES.md  vendored license text; not ours to correct
#
# Patterns are written WITHOUT a leading `./`. codespell matches each skip entry
# against the path as it walks it, so `./tests/snapshots` matches only when the
# scan was started as `codespell .` -- passing `tests` on the command line, as
# the CI step does, yields `tests/snapshots/...` and the entry silently misses.
# Globbed fragments match either way. website/public is Zola's build output and
# gitignored; it is skipped so a stale local build cannot fail the check with
# prose that has already been fixed at the source.
skip = */target/*,*/.git/*,*.lock,website/public/*,*/website/public/*,*/js/*,*.min.js,*.min.css,*.pcap,*.pcapng,*.svg,*.png,*.woff,*.woff2,*.ico,*/snapshots/*,*/cli/out/*,THIRD-PARTY-NOTICES.md,*/superpowers/*
#
# ignore-words-list = real vocabulary codespell mistakes for typos. Each one was
# checked in context rather than waved through:
#   ratatui      the TUI crate; codespell suggests "ratatouille"
#   unparseable  used consistently in 12 places across src/ and the docs; a valid
#                variant, and changing it would be a rename, not a fix
#   statics      Rust nouns -- "`Cow::Borrowed` statics", not "statistics"
#   ans          a binding for an answer timestamp: `.map(|ans| bye - ans)`
#   hel          the expected value in truncate_str("hello", 3) tests
#   nd           IPv6 Neighbor Discovery, beside ARP in kill_packet.rs
#   caf          from the escaped literal "caf\u{e9}" in a CSP-hashing test
#   requestor    RFC 3261's own spelling, quoted verbatim in
#                docs/sip-response-codes.md. "Correcting" a normative quotation
#                would misreport what the RFC says.
#   Sourc        the TRUNCATED "Source" column header, in
#                tests/tui_snapshot_test.rs. Same reason the snapshot
#                directories are skipped above -- it is rendered output, not
#                prose -- but this one lives in the test SOURCE rather than a
#                snapshot file, so the `*/snapshots/*` skip does not reach it.
#                The test asserts the truncated header must NOT appear, because
#                a Source column narrow enough to render "Sourc" cannot hold an
#                IPv4 address and must be dropped instead (#151). "Correcting"
#                it to "Source" would invert what the test checks.
#   medias       rtpengine's OWN key name in an `ng` query reply, quoted while
#                describing the nesting depth a real reply reaches. Correcting
#                it to "media" would misname a protocol field and make the
#                sentence wrong about what is on the wire.
#   nam          a civic-address field name in tests/schemas/vcon.schema.json,
#                the vCon working group's OWN schema, vendored verbatim so the
#                conformance gate runs offline. The field comes from PIDF-LO
#                (RFC 4119), where it names the occupant, and it sits beside
#                `loc`, `flr` and `pc` in the same object. Renaming it would
#                mean the file is no longer the schema the working group
#                published, and the gate would then validate against our edit.
#   sme          a role value the vCon CC extension defines
#                (agent/customer/supervisor/sme/thirdparty), quoted verbatim in
#                `CC_EXTENSION`'s doc comment while explaining why sipnab's own
#                "observer" is permitted beside them. It is an acronym for
#                subject-matter expert, not a misspelling of "same".
#   thirdparty   the same enum, same quotation. codespell wants "third party";
#                the extension writes it as one word and correcting a quoted
#                enum value would misreport what the extension defines.
#   yse          the British verb suffix itself, in tests/us_spelling_test.rs,
#                which defines the rule that BANS it -- the suffix pairs
#                (`-yse` to `-yze`) and the fixtures that prove the rule
#                fires. codespell reads the bare fragment as a typo for
#                "yes"/"use". It is neither: it is the thing being forbidden,
#                quoted by the gate that forbids it, and that file may not
#                contain a whole British word for exactly the same reason.
ignore-words-list = ratatui,unparseable,statics,ans,hel,nd,caf,requestor,Sourc,medias,nam,sme,thirdparty,yse
#
# Deliberately NOT ignored: "cappable", which codespell wanted to make "capable".
# It appeared in "both are small, and both are cappable", where the meaning is
# that the costs can be capped -- codespell's suggestion would have inverted the
# sentence. It was reworded to "both can be capped" instead, which is what the
# rule should push you toward.
check-hidden = true
